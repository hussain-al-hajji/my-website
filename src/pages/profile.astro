---
import Base from '../layouts/Base.astro';
import QRCode from 'qrcode';
import bio from '../data/bio.json';
import pages from '../data/pages.json';
import partners from '../data/partners.json';
import { site, href, abs, getKits, detailsHtml, getGroups } from '../lib/site.js';
import '../styles/profile.css';
import { fillTokens } from '../lib/faq.js';

const p = pages.bio;
const c = site.contact;
const by = (s) => bio.filter((x) => x.section === s);
const kits = getKits();
const orgs = partners.filter((x) => x.marquee).map((x) => x.name);
const qr = await QRCode.toString(abs('/card'), { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1b1b1a', light: '#ffffff' } });
const nums = [
  [site.stats.programs, 'برنامج وفعالية'],
  [site.stats.partners, 'جهة شريكة'],
  [site.stats.beneficiaries, 'مستفيد'],
  [site.stats.proYears, 'سنوات خبرة مهنية'],
  [site.stats.trainYears, 'سنوات خبرة تدريبية'],
];
const fmt = (n) => (n >= 1000 ? n.toLocaleString('en-US') : String(n));
const plus = () => '+';
// أقسام الملف: ما اختير في لوحة التحكم (حتى المخفية عن الصفحة) وبترتيب أقسام صفحة «عنّي»؛ أقسام الوسوم (المهارات...) لا تُدرج
const want = new Set(p.pdf || ['career', 'achievements', 'credentials', 'leadership', 'committees']);
const secs = getGroups('bio', bio).filter((g) => !g.block && g.style !== 'chips' && want.has(g.id) && by(g.id).length).map((g) => [g.id, g.title, g.style]);
// أقسام الوسوم (المهارات ومجالات الخبرة والقيم) تُعرض في الصفحة الأولى تحت الملخص بترتيبها في لوحة التحكم
const tagSecs = getGroups('bio', bio).filter((g) => !g.block && g.style === 'chips' && by(g.id).length);
const siteShort = abs('/').replace(/^https?:\/\//, '').replace(/\/$/, '');
const inShort = c.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<Base title="السيرة الذاتية" description={p.lead} noindex cta={null} bare>
  <main class="pf-page" id="main">
    <p class="no-print pf-bar"><a class="pill" href={href('/hussain-al-hajji-profile.pdf')} download>حمّل السيرة الذاتية (PDF)</a><button type="button" class="more" onclick="print()">طباعة</button></p>
    <article class="pf">
      <header class="pf-head">
        <div class="pf-id">
          <h1>{site.name}</h1>
          <p class="pf-role">{site.role}</p>
          <p class="pf-lead">{p.lead}</p>
          <p class="pf-contact">
            <span>{c.email}</span><span>{c.phone}</span><span>{siteShort}</span><span>{inShort}</span>
          </p>
        </div>
        <img class="pf-photo" src={href('/img/brand/portrait-composite-840.webp')} alt="" width="560" height="694">
      </header>

      <section class="pf-sec">
        <h2>الملخص المهني</h2>
        {p.intro.slice(0, 2).map((t) => <p class="pf-p">{fillTokens(t)}</p>)}
        <ul class="pf-nums">
          {nums.map(([n, t]) => <li><b>{fmt(n)}{plus(n)}</b> {t}</li>)}
        </ul>
      </section>

      {tagSecs.length > 0 && (
        <section class="pf-sec pf-tags">
          {tagSecs.map((g) => (
            <div class="pf-tagrow">
              <h2>{g.title}</h2>
              <ul>{by(g.id).map((x) => <li>{x.title}</li>)}</ul>
            </div>
          ))}
        </section>
      )}

      {secs.map(([s, title, style], i) => (
        <section class={'pf-sec' + (i === 0 && tagSecs.length ? ' pf-newpage' : '')} data-sec={s}>
          <h2>{title}</h2>
          {style === 'table' ? (
            <table class="pf-tbl">
              <thead><tr><th class="c-logo"></th><th class="c-org">الجهة</th><th class="c-title">المسمى أو العنوان</th>{by(s).some((x) => x.desc || x.details) && <th class="c-desc">الوصف</th>}{by(s).some((x) => x.period) && <th class="c-date">التاريخ</th>}</tr></thead>
              <tbody>
                {by(s).map((x) => (
                  <tr>
                    <td class="c-logo">{x.logo ? <img src={href(x.logo)} alt="" width="32" height="32"> : null}</td>
                    <td class="c-org">{x.subtitle}</td>
                    <td class="c-title">{x.title}</td>
                    {by(s).some((y) => y.desc || y.details) && <td class="c-desc">{x.desc && <p>{x.desc}</p>}{x.details && <div class="pf-det" set:html={detailsHtml(x.details)}></div>}</td>}
                    {by(s).some((y) => y.period) && <td class="c-date">{x.period}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
          <ul class="pf-list">
            {by(s).map((x) => (
              <li class="pf-item">
                {x.logo ? <img class="pf-logo" src={href(x.logo)} alt="" width="32" height="32"> : by(s).some((y) => y.logo) ? <span class="pf-logo ph"></span> : null}
                <div class="pf-body">
                  <div class="pf-row"><h3>{x.title}</h3></div>
                  {x.subtitle && <p class="pf-org">{x.subtitle}</p>}
                  {x.desc && <p class="pf-desc">{x.desc}</p>}
                  {x.details && <div class="pf-det" set:html={detailsHtml(x.details)}></div>}
                </div>
                {x.period ? <span class="pf-date">{x.period}</span> : <span></span>}
              </li>
            ))}
          </ul>
          )}
        </section>
      ))}

      <section class="pf-sec">
        <h2>الحقائب التدريبية</h2>
        <ul class="pf-kits">
          {kits.map((k) => <li><b>{k.short}</b> <span>{k.duration}</span></li>)}
        </ul>
      </section>

      <section class="pf-sec">
        <h2>من الجهات التي عملتُ معها</h2>
        <p class="pf-p">{orgs.join('، ')}.</p>
      </section>

      <footer class="pf-foot">
        <ul>
          <li><span>الموقع</span><b class="ltr">{siteShort}</b></li>
          <li><span>البريد</span><b class="ltr">{c.email}</b></li>
          <li><span>الجوال</span><b class="ltr">{c.phone}</b></li>
          <li><span>لينكدإن</span><b class="ltr">{inShort}</b></li>
        </ul>
        <div class="pf-qr" aria-hidden="true" set:html={qr}></div>
      </footer>
    </article>
  </main>
  <script>
    // ‎/profile?s=career,committees: يُبقي الأقسام المختارة فقط (النبذة والوسوم والحقائب ثابتة)، وتبدأ أول خبرة من صفحة جديدة؛ و print=1 تفتح الطباعة
    const q = new URLSearchParams(location.search);
    if (q.has('s')) {
      const want = new Set(q.get('s').split(',').filter(Boolean));
      const secs = [...document.querySelectorAll('[data-sec]')];
      secs.forEach((el) => { el.hidden = !want.has(el.dataset.sec); el.classList.remove('pf-newpage'); });
      secs.find((el) => !el.hidden)?.classList.add('pf-newpage');
    }
    if (q.get('print') === '1') {
      const go = () => setTimeout(() => print(), 300);
      Promise.all([document.fonts?.ready, ...[...document.images].map((i) => (i.complete ? 1 : new Promise((r) => { i.onload = i.onerror = r; })))]).then(go, go);
    }
  </script>
</Base>
