---
import Base from '../layouts/Base.astro';
import QRCode from 'qrcode';
import bio from '../data/bio.json';
import pages from '../data/pages.json';
import partners from '../data/partners.json';
import { site, href, abs, getKits, detailsHtml, getGroups } from '../lib/site.js';
import '../styles/profile.css';
import { fillTokens } from '../lib/faq.js';

const p = pages.bio;
const c = site.contact;
const by = (s) => bio.filter((x) => x.section === s);
const kits = getKits();
const orgs = partners.filter((x) => x.marquee).map((x) => x.name);
const qr = await QRCode.toString(abs('/card'), { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1b1b1a', light: '#ffffff' } });
const nums = [
  [site.stats.programs, 'برنامج وفعالية'],
  [site.stats.partners, 'جهة شريكة'],
  [site.stats.beneficiaries, 'مستفيد'],
  [site.stats.since, 'نشط منذ عام'],
];
const fmt = (n) => (n >= 1000 && n !== site.stats.since ? n.toLocaleString('en-US') : String(n));
const plus = (n) => (n === site.stats.since ? '' : '+');
// أقسام الملف: ما اختير في لوحة التحكم (حتى المخفية عن الصفحة) وبترتيب أقسام صفحة «عنّي»؛ أقسام الوسوم (المهارات...) لا تُدرج
const want = new Set(p.pdf || ['career', 'achievements', 'credentials', 'leadership', 'committees']);
const secs = getGroups('bio', bio).filter((g) => !g.block && g.style !== 'chips' && want.has(g.id) && by(g.id).length).map((g) => [g.id, g.title]);
const siteShort = abs('/').replace(/^https?:\/\//, '').replace(/\/$/, '');
const inShort = c.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<Base title="السيرة الذاتية" description={p.lead} noindex cta={null} bare>
  <main class="pf-page" id="main">
    <p class="no-print pf-bar"><a class="pill" href={href('/hussain-al-hajji-profile.pdf')} download>حمّل السيرة الذاتية (PDF)</a><button type="button" class="more" onclick="print()">طباعة</button></p>
    <article class="pf">
      <header class="pf-head">
        <div class="pf-id">
          <h1>{site.name}</h1>
          <p class="pf-role">{site.role}</p>
          <p class="pf-lead">{p.lead}</p>
          <p class="pf-contact">
            <span>{c.email}</span><span>{c.phone}</span><span>{siteShort}</span><span>{inShort}</span>
          </p>
        </div>
        <img class="pf-photo" src={href('/img/brand/portrait-composite-840.webp')} alt="" width="560" height="694">
      </header>

      <section class="pf-sec">
        <h2>الملخص المهني</h2>
        {p.intro.slice(0, 2).map((t) => <p class="pf-p">{fillTokens(t)}</p>)}
        <ul class="pf-nums">
          {nums.map(([n, t]) => <li><b>{fmt(n)}{plus(n)}</b> {t}</li>)}
        </ul>
      </section>

      {secs.map(([s, title]) => (
        <section class="pf-sec">
          <h2>{title}</h2>
          <ul class="pf-list">
            {by(s).map((x) => (
              <li class="pf-item">
                {x.logo ? <img class="pf-logo" src={href(x.logo)} alt="" width="32" height="32"> : null}
                <div class="pf-body">
                  <div class="pf-row"><h3>{x.title}</h3>{x.period && <span class="pf-date">{x.period}</span>}</div>
                  {x.subtitle && <p class="pf-org">{x.subtitle}</p>}
                  {x.desc && <p class="pf-desc">{x.desc}</p>}
                  {x.details && <div class="pf-det" set:html={detailsHtml(x.details)}></div>}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="pf-sec">
        <h2>الحقائب التدريبية</h2>
        <ul class="pf-kits">
          {kits.map((k) => <li><b>{k.short}</b> <span>{k.duration}</span></li>)}
        </ul>
      </section>

      <section class="pf-sec">
        <h2>من الجهات التي عملتُ معها</h2>
        <p class="pf-p">{orgs.join('، ')}.</p>
      </section>

      <footer class="pf-foot">
        <ul>
          <li><span>الموقع</span><b class="ltr">{siteShort}</b></li>
          <li><span>البريد</span><b class="ltr">{c.email}</b></li>
          <li><span>الجوال</span><b class="ltr">{c.phone}</b></li>
          <li><span>لينكدإن</span><b class="ltr">{inShort}</b></li>
        </ul>
        <div class="pf-qr" aria-hidden="true" set:html={qr}></div>
      </footer>
    </article>
  </main>
</Base>
