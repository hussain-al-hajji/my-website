---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import projects from '../data/projects.json';
import { href } from '../lib/site.js';
---
<Base title="مبادرات مبتكرة" description="مبادرات ومشاريع أسّستها أو شاركتُ في تأسيسها." active="bio" local={[{ label: 'المبادرات', href: '#top' }]}>
  <PageHead title="مبادرات مبتكرة." lead="أفكار تحوّلت إلى منتج أو منصة أو برنامج." />
  <section class="sec tight flush alt" id="top" style="padding-top:60px">
    <div class="wide">
      <div class="cards" style="grid-template-columns:repeat(auto-fill,minmax(340px,1fr))">
        {projects.map((p) => (
          <article class="ccard" data-in>
            <div class="ph contain"><img src={href(p.logo || p.image)} alt={p.name} loading="lazy"></div>
            <div class="body">
              <span class="meta"><span class="tag">{p.status}</span> {p.nameEn}</span>
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              {p.link && <a class="go" href={p.link} rel="noopener">زيارة المشروع</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
