---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import bio from '../data/bio.json';
import pages from '../data/pages.json';
import { href, site, detailsHtml, getGroups, getKits } from '../lib/site.js';
import { fillTokens } from '../lib/faq.js';

const p = pages.bio;
const by = (s) => bio.filter((x) => x.section === s);
// الأقسام بترتيبها وأسمائها من لوحة التحكم؛ الكتلتان «نبذة» و«مسارات العمل» تُرتَّبان معها، والأقسام الفارغة أو المخفية لا تظهر
const shown = getGroups('bio', bio).filter((g) => !g.hidden && (g.block || by(g.id).length));
const firstFold = shown.findIndex((g) => g.block !== 'intro');
// السبورة وفقاعات المهارات في آخر الصفحة (كانتا في الرئيسية): لا تدخلان في ملفات السيرة المستخرجة لأنها تُبنى من أقسام السيرة وحدها
const pillars = (pages.methodology?.pillars || []).slice(0, 5);
const bubbles = bio.filter((x) => ['expertise', 'skills'].includes(x.section)).map((x) => x.title);
const extraData = {
  bubbles,
  collabUrl: href('/collaborate'),
  kits: getKits().map((k) => ({ short: k.short, headline: k.headline, points: k.axes.slice(0, 3).map((a) => a.split(':')[0].trim()), page: href('/collaborate') + '#' + k.id })),
};
const local = [{ label: 'عنّي', href: '#top' }, ...shown.filter((g) => !g.block).slice(0, 4).map((g) => ({ label: g.title, href: '#' + g.id }))];
---
<Base title={p.title} description={p.lead} active="bio" local={local}>
  <PageHead title={p.title} lead={p.lead}>
    <div class="ctas" style="margin-top:28px"><a class="pill" href={href('/work-file')}><svg class="pill-dl" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>عرض البورتفوليو</a><a class="more" href={href('/hussain-al-hajji-profile.pdf')}>السيرة الذاتية PDF</a><a class="more" href={href('/card')}>بطاقتي الرقمية</a></div>
  </PageHead>

  {shown.map((g, i) => {
    const anchor = i === 0 ? <span id="top"></span> : null;
    const tools = i === firstFold && i > 0 ? (
      <div class="fold-tools measure" role="group" aria-label="عرض الأقسام">
        <span>استعرض أقسام السيرة</span>
        <button type="button" data-fold-all="open">فتح الكل</button>
        <button type="button" data-fold-all="close">طيّ الكل</button>
      </div>
    ) : null;
    if (g.block === 'intro') return (
      <section class="sec tight flush" id={g.id}>{anchor}
        <div class="measure"><div class="prose">{p.intro.map((t) => <p>{fillTokens(t)}</p>)}</div></div>
      </section>
    );
    if (g.block === 'tracks') return (
      <section class="sec alt tight" id={g.id}>{anchor}{tools}
        <div class="wide">
          <details class="fold-sec">
            <summary><h2 class="h2" data-in>{g.title}.</h2><span class="tri" aria-hidden="true"></span></summary>
            <div class="fold-body">
              <div class="cards">
                {p.tracks.map((t) => (
                  <article class="ccard"><div class="body"><h3>{t.title}</h3><p>{t.text}</p></div></article>
                ))}
              </div>
              <p class="lede" style="margin-top:36px">{p.closing}</p>
            </div>
          </details>
        </div>
      </section>
    );
    const items = by(g.id);
    return (
    <section class={`sec tight${i % 2 ? ' alt' : ''}`} id={g.id}>{anchor}{tools}
      <div class="measure">
        <details class="fold-sec">
          <summary><h2 class="h2" data-in>{g.title}.</h2><span class="fold-n">{items.length}</span><span class="tri" aria-hidden="true"></span></summary>
          <div class="fold-body">
        {g.style === 'chips' ? (
          <ul class="chip-list">{items.map((it) => <li>{it.title}</li>)}</ul>
        ) : g.style === 'table' ? (
          <table class="bio-tbl">
            <thead><tr><th class="c-logo"><span class="sr-only">الشعار</span></th><th class="c-org">الجهة</th><th class="c-title">المسمى أو العنوان</th>{items.some((x) => x.desc || x.details) && <th class="c-desc">الوصف</th>}{items.some((x) => x.period) && <th class="c-date">التاريخ</th>}</tr></thead>
            <tbody>
              {items.map((it) => (
                <tr>
                  <td class="c-logo">{it.logo ? <img src={href(it.logo)} alt="" loading="lazy" width="48" height="48"> : null}</td>
                  <td data-l="الجهة" class="c-org">{it.subtitle}</td>
                  <td data-l="المسمى" class="c-title">{it.link ? <a href={it.link} rel="noopener"><b>{it.title}</b></a> : <b>{it.title}</b>}</td>
                  {items.some((x) => x.desc || x.details) && <td data-l="الوصف" class="c-desc">
                    {(it.desc || it.details) && (
                      <div class="more-box" data-more>
                        <div class="more-body">
                          {it.desc && <p>{it.desc}</p>}
                          {it.details && <div class="more-det" set:html={detailsHtml(it.details)}></div>}
                        </div>
                        <button type="button" class="more-btn" aria-expanded="false" hidden>عرض المزيد</button>
                      </div>
                    )}
                  </td>}
                  {items.some((x) => x.period) && <td data-l="التاريخ" class="c-date">{it.period}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <ol class="tl">
            {items.map((it) => (
              <li>
                <span class="period">{it.period}</span>
                <div class="tl-row">
                  {it.logo ? <img class="tl-logo" src={href(it.logo)} alt={it.subtitle || ''} loading="lazy" width="56" height="56"> : items.some((x) => x.logo) ? <span class="tl-logo ph" /> : null}
                  <div class="tl-body">
                    {it.link
                      ? <a href={it.link} rel="noopener"><b>{it.title}</b></a>
                      : <b>{it.title}</b>}
                    {it.subtitle && <span class="org">{it.subtitle}</span>}
                    {(it.desc || it.details) && (
                      <div class="more-box" data-more>
                        <div class="more-body">
                          {it.desc && <p>{it.desc}</p>}
                          {it.details && <div class="more-det" set:html={detailsHtml(it.details)}></div>}
                        </div>
                        <button type="button" class="more-btn" aria-expanded="false" hidden>عرض المزيد</button>
                      </div>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        )}
          </div>
        </details>
      </div>
    </section>
    );
  })}
  {pillars.length > 0 && (
<section class="sec board" id="methodology-board" aria-labelledby="bd-h">
  <div class="wide">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="chalk" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="4" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="2.2"/></filter></svg>
    <div class="bd-frame">
      <h2 id="bd-h" class="chalk"><span>منهجي في التدريب</span></h2>
      <svg class="chalk-line" viewBox="0 0 300 18" aria-hidden="true"><path d="M3 10C40 3 70 15 110 8S190 4 230 10S280 11 297 6" pathLength="1"/></svg>
      <ol class="bd-steps">
        {pillars.map((pl, i) => (
          <li class="bd-step">
            <span class="bd-n"><svg viewBox="0 0 80 80" aria-hidden="true"><path d="M40 6C60 4 76 20 74 42S58 76 36 74S4 58 7 36S22 8 44 7" pathLength="1"/></svg><b>{i + 1}</b></span>
            <h3 class="chalk">{pl.title}</h3>
            <p>{pl.text}</p>
            {i < pillars.length - 1 && <svg class="bd-arrow" viewBox="0 0 120 40" aria-hidden="true"><path d="M112 22C84 8 52 32 14 18" pathLength="1"/><path d="M26 6L12 18L28 30" pathLength="1"/></svg>}
          </li>
        ))}
      </ol>
      <a class="chalk-link" href={href('/methodology')}>اقرأ منهجي كاملاً</a>
    </div>
  </div>
</section>
  )}
  {bubbles.length > 3 && (
<section class="sec bubsec" id="expertise-bubbles" aria-labelledby="bb-h">
  <div class="wide">
    <div class="sec-head"><h2 id="bb-h" data-in>مجالات<br>خبرتي.</h2></div>
    <p class="net-note">اسحب الكرات وارمِها، واضغط على أي مجال لترى الحقائب المرتبطة به.</p>
    <div class="bub-field" id="bubField"></div>
    <div class="bub-panel" id="bubPanel" aria-live="polite"></div>
  </div>
</section>
  )}
  <script type="application/json" id="bioExtraData" set:html={JSON.stringify(extraData)}></script>
  <script>import '../scripts/more.js';
import '../scripts/fold.js';
import '../scripts/bio-extras.js';</script>
</Base>
