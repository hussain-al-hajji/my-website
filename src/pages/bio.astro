---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import bio from '../data/bio.json';
import pages from '../data/pages.json';
import { href, BIO_SECTION, site } from '../lib/site.js';

const p = pages.bio;
const order = ['career', 'achievements', 'credentials', 'committees', 'leadership', 'mentoring', 'bootcamps', 'learning', 'writing', 'volunteer'];
const chipSections = ['expertise', 'skills', 'values'];
const by = (s) => bio.filter((x) => x.section === s);
const local = [{ label: 'السيرة', href: '#top' }, ...order.filter((s) => by(s).length).slice(0, 4).map((s) => ({ label: BIO_SECTION[s], href: '#' + s }))];
---
<Base title={p.title} description={p.lead} active="bio" local={local}>
  <PageHead title={p.title} lead={p.lead}>
    <div class="ctas" style="margin-top:28px"><a class="pill" href={href('/contact')}>اطلب برنامجاً</a><a class="more" href={href('/featured')}>مشاريع ومشاركات مميزة</a><a class="more" href={href('/hussain-al-hajji-profile.pdf')}>حمّل ملفي التعريفي (PDF)</a><a class="more" href={href('/card')}>بطاقتي الرقمية</a></div>
  </PageHead>

  <section class="sec tight flush" id="top">
    <div class="measure">
      <div class="prose">
        {p.intro.map((t) => <p>{t}</p>)}
      </div>
    </div>
  </section>

  <section class="sec alt tight">
    <div class="wide">
      <h2 class="h2" style="margin-bottom:28px" data-in>مسارات العمل.</h2>
      <div class="cards">
        {p.tracks.map((t) => (
          <article class="ccard" data-in><div class="body"><h3>{t.title}</h3><p>{t.text}</p></div></article>
        ))}
      </div>
      <p class="lede" style="margin-top:36px">{p.closing}</p>
    </div>
  </section>

  {order.filter((s) => by(s).length).map((s, i) => (
    <section class={`sec tight${i % 2 ? ' alt' : ''}`} id={s}>
      <div class="measure">
        <h2 class="h2" style="margin-bottom:28px" data-in>{BIO_SECTION[s]}.</h2>
        <ol class="tl">
          {by(s).map((it) => (
            <li>
              <span class="period">{it.period}</span>
              <div>
                {it.link
                  ? <a href={it.link} rel="noopener"><b>{it.title}</b></a>
                  : <b>{it.title}</b>}
                {it.subtitle && <span class="org">{it.subtitle}</span>}
                {it.desc && <p>{it.desc}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ))}

  <section class="sec tight dark">
    <div class="measure">
      {chipSections.filter((s) => by(s).length).map((s) => (
        <div style="margin-bottom:44px">
          <h2 class="h2" style="margin-bottom:20px">{BIO_SECTION[s]}.</h2>
          <ul class="chip-list">{by(s).map((it) => <li style="background:var(--tile-dark)">{it.title}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>
</Base>
