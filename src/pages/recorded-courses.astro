---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { courses, href } from '../lib/site.js';
const recorded = courses.filter((c) => c.kind === 'recorded');
const upcoming = courses.filter((c) => c.kind === 'upcoming');
---
<Base title="محتوى مرئي" description="لقاءات وبودكاست ومحتوى مسجّل قدّمتُه أو شاركتُ فيه، متاح للمشاهدة." active="blog" local={[{ label: 'المشاهدات', href: '#top' }]}>
  <PageHead title="محتوى مرئي." lead="لقاءات وبودكاست ومحتوى مسجّل قدّمتُه أو شاركتُ فيه، متاح للمشاهدة." />
  {upcoming.length > 0 && (
    <section class="sec alt tight flush" style="padding-top:60px">
      <div class="wide">
        <h2 class="h2" style="margin-bottom:24px">قريباً.</h2>
        <div class="cards">
          {upcoming.map((c) => (
            <article class="ccard"><div class="ph"><img src={href(c.image)} alt="" loading="lazy"></div><div class="body"><h3>{c.title}</h3><span class="meta">{c.platform}</span><p>{c.desc}</p></div></article>
          ))}
        </div>
      </div>
    </section>
  )}
  <section class="sec tight" id="top">
    <div class="wide">
      <div class="cards">
        {recorded.map((c) => (
          <a class="ccard line" href={c.link} rel="noopener">
            <div class="ph"><img src={href(c.image)} alt="" loading="lazy"></div>
            <div class="body"><h3>{c.title}</h3><span class="meta">{c.platform}</span><p>{c.desc}</p><span class="go">شاهد</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
