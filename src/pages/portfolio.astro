---
// ملف الأعمال (Portfolio): صفحات A4 أفقية تُحوَّل إلى PDF عند البناء (scripts/make-pdf.mjs)، وكل رقم فيها محسوب من src/data.
import Base from '../layouts/Base.astro';
import QRCode from 'qrcode';
import '../styles/portfolio.css';
import pages from '../data/pages.json';
import projects from '../data/projects.json';
import featured from '../data/featured.json';
import partners from '../data/partners.json';
import award from '../data/award.json';
import testimonials from '../data/testimonials.json';
import mediaAll from '../data/media.json';
import honors from '../data/honors.json';
import { site, href, abs, getKits, records, stats, isRemote, getGroups } from '../lib/site.js';
import { fillTokens } from '../lib/faq.js';
import { mapShapes } from '../lib/impactmap.js';
import geo from '../assets/gulf-geo.html?raw';

const st = stats();
const featTitle = Object.fromEntries(getGroups('featured', featured).map((g) => [g.id, g.title]));
const y0 = st.years[0], y1 = st.lastYear;
const kits = getKits();
const n = (v) => Number(v).toLocaleString('en-US');
const intro = (pages.bio.intro || []).map(fillTokens);
const remoteN = records.filter(isRemote).length;
const inN = records.length - remoteN;
const logos = partners.filter((p) => p.logo);
// التوصيات المنشورة في الرئيسية نفسها (المميّزة)
const voices = testimonials.filter((t) => t.kind === 'recommendation' && t.featured && (t.quote || t.full)).map((t) => ({ ...t, text: (t.quote || t.full).replace(/^[“"]|[”"]$/g, '') }));
const seen = new Set();
// شعارات الاستضافات الإعلامية (حقل «شعار البورتفليو» في قسم الإعلام)، شعار واحد لكل جهة
const outlets = mediaAll.filter((m) => m.pdfLogo).map((m) => ({ name: (m.short || m.outlet.split('،')[0]).trim(), logo: m.pdfLogo })).filter((o) => (seen.has(o.logo) ? false : seen.add(o.logo)));
const qr = await QRCode.toString(abs('/'), { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#f5f5f2', light: '#0b0b0a' } });

// الغلاف: كل برنامج في السجل نقطة على حلزون ذهبي، والأحدث أسطع
const GA = Math.PI * (3 - Math.sqrt(5));
const galaxy = [...records].sort((a, b) => a.year - b.year).map((r, i, arr) => {
  const rr = 7.4 * Math.sqrt(i + 4), t = i * GA;
  return { x: 200 + rr * Math.cos(t), y: 200 + rr * Math.sin(t), o: 0.28 + 0.72 * ((r.year - y0) / Math.max(1, y1 - y0)), s: 2.1 + (i % 7 === 0 ? 1.1 : 0) };
});

// الأثر في أرقام: أعمدة سنوات من نقاط (الأقدم يميناً)، والمواضيع
const perYear = st.years.map((y) => ({ y, c: records.filter((r) => r.year === y).length }));
const maxY = Math.max(...perYear.map((p) => p.c));
const COLS = 4, DOT = 9, colW = 64;
const yearsSvgW = perYear.length * colW;
const yearsSvgH = Math.ceil(maxY / COLS) * DOT + 46;
const tcount = {};
records.forEach((r) => { tcount[r.topic] = (tcount[r.topic] || 0) + 1; });
const topicsAll = Object.entries(tcount).filter(([t]) => t !== 'أخرى').sort((a, b) => b[1] - a[1]);
const topics = topicsAll.slice(0, 6);
const otherT = topicsAll.slice(6).reduce((a, b) => a + b[1], 0) + (tcount['أخرى'] || 0);
if (otherT) topics.push(['مواضيع أخرى', otherT]);
// أمثلة «مواضيع أخرى»: عناوين تُحرَّر من لوحة التحكم (portfolioTopicExamples)
const otherSamples = site.portfolioTopicExamples || [];
const remoteDeg = (remoteN / records.length) * 360;

const chunk = (arr, k) => arr.reduce((a, x, i) => (i % k ? a[a.length - 1].push(x) : a.push([x]), a), []);
const projPages = chunk(projects, 4);
const featPages = chunk(featured, 8);
const kitPages = chunk(kits, 6);

// ترقيم الصفحات
let pg = 1;
const P = () => String(++pg).padStart(2, '0');
const pillars = (pages.methodology?.pillars || []).slice(0, 5);
const impactMap = mapShapes(records);
const topCities = [...impactMap.placed].sort((a, b) => b.n - a.n).slice(0, 6);
const TOTAL = 1 + 1 + (impactMap.total ? 1 : 0) + 1 + (pillars.length ? 1 : 0) + projPages.length + 1 + featPages.length + kitPages.length + 1 + (voices.length ? 1 : 0) + 1;
const tot = String(TOTAL).padStart(2, '0');
// صورة لحظة التكريم من معرض الجائزة، وإلا صورة الصفحة الرئيسية للجائزة
const awardImg = (award.gallery || []).find((g) => /لحظة التكريم/.test(g.caption || ''))?.image || award.hero;
// الصورة الجماعية للمكرّمين في حفل التكريم
const awardGroup = (award.gallery || []).find((g) => /صورة جماعية لرواد الشباب العربي في النسخة الرابعة/.test(g.caption || '')) || (award.gallery || []).find((g) => /صورة جماعية/.test(g.caption || ''));
// أدواري في التعاون (من لوحة التحكم)، ولكل دور أيقونة خطية بحسب كلماته
const roles = site.portfolioRoles || [];
const ICONS = [
  [/مدرب/, '<path d="M3 4h18v11H3z"/><path d="M8 20l4-5 4 5"/><path d="M7 11l3-3 2 2 4-4"/>'],
  [/مرشد/, '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>'],
  [/مستشار/, '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9V16h7v-2.1A6 6 0 0 0 12 3z"/>'],
  [/مطور|مبادر/, '<path d="M12 21v-8"/><path d="M12 13c0-4 3-6 7-6 0 4-3 6-7 6z"/><path d="M12 15c0-3-2.5-5-6-5 0 3 2.5 5 6 5z"/>'],
  [/مدير|مشاريع/, '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h5M8 17h7"/><path d="M4 9h2"/>'],
  [/محك/, '<path d="M12 3v18M6 21h12"/><path d="M5 7h14"/><path d="M5 7l-3 6a3 3 0 0 0 6 0zM19 7l-3 6a3 3 0 0 0 6 0z"/>'],
  [/كاتب|محتوى/, '<path d="M4 20l4-1 11-11-3-3L5 16z"/><path d="M14 6l3 3"/>'],
];
const roleIcon = (r) => `<svg viewBox="0 0 24 24" aria-hidden="true">${(ICONS.find(([re]) => re.test(r)) || [0, '<circle cx="12" cy="12" r="8"/>'])[1]}</svg>`;
const order = ['me', ...(impactMap.total ? ['map'] : []), 'impact', ...(pillars.length ? ['method'] : []), 'proj', 'award', 'feat', 'kits', 'partners', 'voices'];
const sec = Object.fromEntries(order.map((k, i) => [k, String(i + 1).padStart(2, '0')]));
---
<Base title="ملف الأعمال" description={`ملف أعمالي ومشاريعي منذ ${y0}.`} noindex cta={null} bare>
  <main class="pp-doc" id="main">
    <p class="no-print pp-bar"><a class="pill" href={href('/hussain-al-hajji-portfolio.pdf')} download>حمّل البورتفليو (PDF)</a><a class="more" href={href('/')}>العودة إلى الموقع</a></p>

    <!-- الغلاف -->
    <section class="pp pp-dark pp-cover">
      <svg class="pp-galaxy" viewBox="0 0 400 400" aria-hidden="true">
        {galaxy.map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r={d.s} fill="#e2b257" opacity={d.o.toFixed(2)} />)}
      </svg>
      <img class="pp-cover-photo" src={href('/img/brand/portrait-photo-840.webp')} alt="" width="560" height="694">
      <div class="pp-cover-txt">
        <p class="pp-kicker">ملف الأعمال · Portfolio</p>
        <h1><img src={href('/brand/logo-full-white.svg')} alt={site.name + '، ' + site.tagline} width="2600" height="961"></h1>
        <p class="pp-cover-role">{site.role}</p>
        <p class="pp-cover-years"><b>{y0}</b><i></i><b>{y1}</b></p>
      </div>
    </section>

    <!-- من أنا -->
    <section class="pp pp-paper">
      <header class="pp-head"><span class="pp-num">{sec.me}</span><h2>من أنا</h2><img class="pp-mark" src={href('/brand/logo-full-black.svg')} alt="" width="2600" height="961"></header>
      <div class="pp-me">
        <div class="pp-me-txt">
          <p class="pp-lead">{pages.bio.lead}</p>
          {intro.slice(0, 2).map((t) => <p class="pp-just">{t}</p>)}
          {roles.length > 0 && (
            <div class="pp-roles">
              <h3 class="pp-sub">أدوار يمكننا التعاون فيها</h3>
              <ul>{roles.map((r, i) => <li><span class="ic" set:html={roleIcon(r)}></span><b>{r}</b><i>{String(i + 1).padStart(2, '0')}</i></li>)}</ul>
            </div>
          )}
        </div>
        <figure class="pp-me-fig"><img src={href('/img/brand/portrait-composite-840.webp')} alt="" width="560" height="694"></figure>
      </div>
      <ul class="pp-stats">
        <li><b>{n(site.stats.programs)}+</b><span>برنامج وفعالية</span></li>
        <li><b>{n(site.stats.partners)}+</b><span>جهة شريكة</span></li>
        <li><b>{n(site.stats.beneficiaries)}+</b><span>مستفيد</span></li>
        <li><b>{n(kits.length)}</b><span>حقيبة تدريبية</span></li>
      </ul>
      <footer class="pp-foot"><span>hussain-al-hajji.com</span><span dir="ltr">{P()} / {tot}</span></footer>
    </section>

    <!-- خريطة الأثر: نفس خريطة الرئيسية مرسومة كاملة -->
    {impactMap.total > 0 && (
      <section class="pp pp-dark pp-map">
        <header class="pp-head"><span class="pp-num">{sec.map}</span><h2>خريطة الأثر</h2><img class="pp-mark" src={href('/brand/logo-full-white.svg')} alt="" width="2600" height="961"></header>
        <div class="pp-map-body">
          <svg class="map in" viewBox="0 0 1000 600" role="img" aria-label="خريطة المدن التي قُدّمت فيها البرامج">
            <g class="geo" aria-hidden="true" set:html={geo}></g>
            <g>{impactMap.placed.filter((c) => c.arc).map((c) => <path class="arc" d={c.arc} />)}</g>
            <g>{impactMap.placed.map((c) => (
              <g class="c">
                <circle class="halo" cx={c.x} cy={c.y} r={c.rad * 2} />
                <circle class={'city' + (c.isHome ? ' home' : '')} cx={c.x} cy={c.y} r={c.rad} />
                {c.label && <text x={c.label.x} y={c.label.y} text-anchor={c.label.anchor} direction="rtl">{c.name}</text>}
                {c.label && <text class="sm" x={c.label.x} y={c.label.y + 18} text-anchor={c.label.anchor} direction="rtl">{c.n} مشاركة</text>}
              </g>
            ))}</g>
          </svg>
          <aside class="pp-map-side">
            <p class="pp-map-count"><b>{impactMap.total}</b><span>{impactMap.label}</span></p>
            <p class="pp-cap">أكثر المواقع مشاركة</p>
            <ol class="pp-map-top">{topCities.map((c) => <li><span>{c.name}</span><b>{c.n}</b></li>)}</ol>
            <p class="pp-map-home"><i></i>الأحساء، منطلق الرحلة، ومنها تمتد الأقواس إلى كل موقع.</p>
          </aside>
        </div>
        <footer class="pp-foot"><span>hussain-al-hajji.com</span><span dir="ltr">{P()} / {tot}</span></footer>
      </section>
    )}

    <!-- الأثر في أرقام -->
    <section class="pp pp-dark">
      <header class="pp-head"><span class="pp-num">{sec.impact}</span><h2>الأثر في أرقام</h2><img class="pp-mark" src={href('/brand/logo-full-white.svg')} alt="" width="2600" height="961"></header>
      <div class="pp-impact">
        <div class="pp-years">
          <p class="pp-cap">{n(records.length)} برنامجاً موثّقاً، سنة بعد سنة (كل نقطة برنامج)</p>
          <svg viewBox={`0 0 ${yearsSvgW} ${yearsSvgH}`} aria-hidden="true">
            {perYear.map((p, i) => {
              const cx = yearsSvgW - colW * (i + 0.5);
              return (<g>
                {Array.from({ length: p.c }, (_, k) => <circle cx={cx + ((k % COLS) - (COLS - 1) / 2) * DOT} cy={yearsSvgH - 40 - Math.floor(k / COLS) * DOT} r="3.3" fill="#e2b257" />)}
                <text x={cx} y={yearsSvgH - 20} text-anchor="middle" class="yl">{p.y}</text>
                <text x={cx} y={yearsSvgH - 4} text-anchor="middle" class="yc">{p.c}</text>
              </g>);
            })}
          </svg>
        </div>
        <div class="pp-side">
          <div class="pp-split">
            <div class="pp-donut" style={`--d:${remoteDeg.toFixed(1)}deg`}><span><b>{n(records.length)}</b>برنامجاً</span></div>
            <ul>
              <li><i class="a"></i><b>{n(inN)}</b> حضورياً</li>
              <li><i class="b"></i><b>{n(remoteN)}</b> عن بُعد</li>
            </ul>
          </div>
          <p class="pp-cap" style="margin-bottom:0">أكثر المواضيع</p>
          <ul class="pp-topics">
            {topics.map(([t, c]) => <li><span>{t}</span><b>{c}</b><i style={`--w:${(c / topics[0][1] * 100).toFixed(1)}%`}></i></li>)}
          </ul>
          {otherSamples.length > 0 && (
            <ul class="pp-samples" aria-label="نماذج من مواضيع أخرى">
              {otherSamples.map((s) => <li>{s}</li>)}
            </ul>
          )}
        </div>
      </div>
      <footer class="pp-foot"><span>hussain-al-hajji.com</span><span dir="ltr">{P()} / {tot}</span></footer>
    </section>

    <!-- منهجي في التدريب: سبورة الرئيسية نفسها مرسومة كاملة -->
    {pillars.length > 0 && (
      <section class="pp pp-paper pp-method">
        <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="chalk" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="4" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="2.2"/></filter></svg>
        <header class="pp-head"><span class="pp-num">{sec.method}</span><img class="pp-mark" src={href('/brand/logo-full-black.svg')} alt="" width="2600" height="961"></header>
        <div class="bd-frame">
          <h2 id="bd-h" class="chalk drawn"><span class="hl">منهجي في التدريب</span></h2>
          <svg class="chalk-line drawn" viewBox="0 0 300 18" aria-hidden="true"><path d="M3 10C40 3 70 15 110 8S190 4 230 10S280 11 297 6" pathLength="1"/></svg>
          <ol class="bd-steps">
            {pillars.map((pl, i) => (
              <li class="bd-step drawn">
                <span class="bd-n"><svg viewBox="0 0 80 80" aria-hidden="true"><path d="M40 6C60 4 76 20 74 42S58 76 36 74S4 58 7 36S22 8 44 7" pathLength="1"/></svg><b>{i + 1}</b></span>
                <h3 class="chalk"><span class="hl">{pl.title}</span></h3>
                <p>{pl.text}</p>
                {i < pillars.length - 1 && <svg class="bd-arrow" viewBox="0 0 120 40" aria-hidden="true"><path d="M112 22C84 8 52 32 14 18" pathLength="1"/><path d="M26 6L12 18L28 30" pathLength="1"/></svg>}
              </li>
            ))}
          </ol>
          <a class="chalk-link" href={abs('/methodology')}>اقرأ منهجي كاملاً: hussain-al-hajji.com/methodology</a>
        </div>
        <footer class="pp-foot"><span>hussain-al-hajji.com/methodology</span><span dir="ltr">{P()} / {tot}</span></footer>
      </section>
    )}

    <!-- مشاريعي -->
    {projPages.map((list, pi) => (
      <section class="pp pp-paper">
        <header class="pp-head"><span class="pp-num">{sec.proj}</span><h2>مشاريع أسستها{projPages.length > 1 && <small> {pi + 1}/{projPages.length}</small>}</h2><img class="pp-mark" src={href('/brand/logo-full-black.svg')} alt="" width="2600" height="961"></header>
        <div class="pp-proj">
          {list.map((p) => (
            <article>
              {p.image ? <img src={href(p.image)} alt="" loading="eager"> : <span class="ph"></span>}
              <div>
                <h3>{p.name}{p.nameEn && <small dir="ltr">{p.nameEn}</small>}</h3>
                {p.status && <p class="tag">{p.status}</p>}
                <p class="pp-just clamp">{p.desc}</p>
              </div>
            </article>
          ))}
        </div>
        <footer class="pp-foot"><span>hussain-al-hajji.com/my-projects</span><span dir="ltr">{P()} / {tot}</span></footer>
      </section>
    ))}

    <!-- رواد الشباب العربي -->
    <section class="pp pp-dark pp-award">
      <img class="pp-award-img" src={href(awardImg)} alt="">
      <div class="pp-award-txt">
        <header class="pp-head"><span class="pp-num">{sec.award}</span><h2>{award.title}</h2></header>
        <p class="pp-kicker">{award.edition} · {award.dates}</p>
        <p class="pp-lead">{award.lead}</p>
        {award.story?.[0] && <p class="pp-just pp-story">{award.story[0]}</p>}
        <ul class="pp-facts">{(award.facts || []).slice(0, 4).map((f) => <li><b>{f.value}</b><span>{f.label}</span></li>)}</ul>
        <p class="pp-fine">{award.sponsor}</p>
      </div>
      {awardGroup && <figure class="pp-group"><img src={href(awardGroup.image)} alt=""><figcaption>{awardGroup.caption}</figcaption></figure>}
      <footer class="pp-foot"><span>hussain-al-hajji.com/arab-youth-pioneers</span><span dir="ltr">{P()} / {tot}</span></footer>
    </section>

    <!-- مشاركات مميزة -->
    {featPages.map((list, pi) => (
      <section class="pp pp-paper">
        <header class="pp-head"><span class="pp-num">{sec.feat}</span><h2>مشاريع ومشاركات مميزة{featPages.length > 1 && <small> {pi + 1}/{featPages.length}</small>}</h2><img class="pp-mark" src={href('/brand/logo-full-black.svg')} alt="" width="2600" height="961"></header>
        <div class="pp-feat">
          {list.map((f) => (
            <article>
              <span class="lg">{f.logo && <img src={href(f.logo)} alt="" loading="eager">}</span>
              <div><p class="grp">{featTitle[f.group] || f.group}</p><h3 class="clamp3">{f.title}</h3>{f.orgs && <p class="org">{f.orgs}</p>}</div>
            </article>
          ))}
        </div>
        <footer class="pp-foot"><span>hussain-al-hajji.com/featured</span><span dir="ltr">{P()} / {tot}</span></footer>
      </section>
    ))}

    <!-- الحقائب -->
    {kitPages.map((list, pi) => (
      <section class="pp pp-paper pp-alt">
        <header class="pp-head"><span class="pp-num">{sec.kits}</span><h2>حقائب تدريبية جاهزة للتخصيص{kitPages.length > 1 && <small> {pi + 1}/{kitPages.length}</small>}</h2><img class="pp-mark" src={href('/brand/logo-full-black.svg')} alt="" width="2600" height="961"></header>
        <div class="pp-kits">
          {list.map((k) => (
            <article>
              <img src={href(k.image)} alt="" loading="eager">
              <h3>{k.short || k.title}</h3>
              <p class="dur">{k.duration}</p>
              {k.headline && <p class="hl">{k.headline}</p>}
            </article>
          ))}
        </div>
        <footer class="pp-foot"><span>hussain-al-hajji.com/collaborate</span><span dir="ltr">{P()} / {tot}</span></footer>
      </section>
    ))}

    <!-- الشركاء والإعلام -->
    <section class="pp pp-paper">
      <header class="pp-head"><span class="pp-num">{sec.partners}</span><h2>جهات صنعتُ معها الأثر</h2><img class="pp-mark" src={href('/brand/logo-full-black.svg')} alt="" width="2600" height="961"></header>
      <ul class="pp-logos">{logos.slice(0, 60).map((p) => <li><img src={href(p.logo)} alt={p.name} loading="eager"></li>)}</ul>
      {outlets.length > 0 && (
        <div class="pp-media"><h3 class="pp-sub">استضافات في الصحافة والإعلام</h3><ul class="pp-mlogos">{outlets.map((o) => <li><img src={href(o.logo)} alt={o.name} loading="eager"></li>)}</ul></div>
      )}
      <footer class="pp-foot"><span>hussain-al-hajji.com/partnerships</span><span dir="ltr">{P()} / {tot}</span></footer>
    </section>

    <!-- قالوا -->
    {voices.length > 0 && (
      <section class="pp pp-dark">
        <header class="pp-head"><span class="pp-num">{sec.voices}</span><h2>قالوا عن العمل معي</h2><img class="pp-mark" src={href('/brand/logo-full-white.svg')} alt="" width="2600" height="961"></header>
        <div class="pp-voices" style={`--n:${voices.length}`}>
          {voices.map((t) => (
            <blockquote><p class="pp-just">{t.text}</p>{(t.name || t.role) && <footer>{t.name && <b>{t.name}</b>}{t.role && <span>{t.role}</span>}</footer>}</blockquote>
          ))}
        </div>
        <p class="pp-honors">و{n(honors.length)} شهادة شكر وتقدير من الجهات التي عملتُ معها.</p>
        <footer class="pp-foot"><span>hussain-al-hajji.com/feedback</span><span dir="ltr">{P()} / {tot}</span></footer>
      </section>
    )}

    <!-- الغلاف الخلفي -->
    <section class="pp pp-dark pp-back">
      <svg class="pp-galaxy" viewBox="0 0 400 400" aria-hidden="true">
        {galaxy.map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r={d.s} fill="#e2b257" opacity={(d.o * 0.5).toFixed(2)} />)}
      </svg>
      <div class="pp-back-txt">
        <h2>لنصنع الأثر معاً.</h2>
