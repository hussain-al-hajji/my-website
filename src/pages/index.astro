---
import Base from '../layouts/Base.astro';
import geo from '../assets/gulf-geo.html?raw';
import ring from '../data/ring.json';
import highlights from '../data/highlights.json';
import award from '../data/award.json';
import testimonials from '../data/testimonials.json';
import partners from '../data/partners.json';
import { wheelItems, rangeAr, stateOf, eventSchemas } from '../lib/calendar.js';
import media from '../data/media.json';
import pagesData from '../data/pages.json';
import bioData from '../data/bio.json';
import { site, href, abs, getNews, getKits, logForClient, stats, dateAr, norm, records, AUDIENCES, TIMES, GOALS, contactLinks } from '../lib/site.js';

const st = stats();
const marquee = partners.filter((p) => p.marquee);
const xpItems = site.experience.items;
const xpSplit = Math.ceil(xpItems.length / 2);
const xpA = xpItems.slice(0, xpSplit), xpB = xpItems.slice(xpSplit);
const S = (d) => `<svg viewBox="0 0 24 24" aria-hidden="true">${d}</svg>`;
const ICONS = {
  user: S('<circle cx="12" cy="8" r="3.6"/><path d="M5 20c.8-3.6 3.6-5.4 7-5.4s6.2 1.8 7 5.4"/>'),
  calendar: S('<rect x="4" y="5" width="16" height="15" rx="2.5"/><path d="M8 3v4M16 3v4M4 10h16m-9 5 2 2 3.5-4"/>'),
  bulb: S('<path d="M9.5 18h5M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.4 1.1 2.2h5c0-.8.4-1.6 1.1-2.2A6 6 0 0 0 12 3Z"/>'),
  handshake: S('<path d="m3 11 4-4 4 1.5 3-2 4 3 3 3-5 5-3-1.5-3 1.5L5 16Z"/><path d="m9 15 2 2"/>'),
  award: S('<circle cx="12" cy="9" r="5"/><path d="m9 13.5-1.5 7 4.5-2.6 4.5 2.6-1.5-7"/>'),
  book: S('<path d="M12 6c-2-1.5-5-2-8-1.5v13c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5v-13c-3-.5-6 0-8 1.5ZM12 6v13"/>'),
  spark: S('<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8Z"/><path d="M18.5 16.5v3M17 18h3"/>'),
};
const links = contactLinks();
const news = getNews().slice(0, 3);
const kits = getKits();
const voices = testimonials.filter((t) => t.kind === 'recommendation' && t.featured && (t.quote || t.full));
const awardFacts = award.facts.filter((f) => ['40', '13', '4'].includes(f.value));

// منهجي على السبورة
const pillars = (pagesData.methodology?.pillars || []).slice(0, 5);
// فقاعات المهارات: مجالات الخبرة والمهارات من السيرة
const bubbles = bioData.filter((x) => ['expertise', 'skills'].includes(x.section)).map((x) => x.title);
// شبكة الشراكات: أكثر الجهات حضوراً في سجل الأثر مع برامجها
const netAll = partners.filter((p) => p.logo).map((p) => {
  const nm = norm(p.name).replace(/[()]/g, ' ').replace(/\s+/g, ' ').trim();
  const recs = records.filter((r) => norm(r.org || '').includes(nm)).map((r) => ({ t: r.title, y: r.year }));
  return { name: p.name, logo: href(p.logo), recs };
}).filter((x) => x.recs.length >= 2).sort((a, b) => b.recs.length - a.recs.length).slice(0, 14);

const homeData = {
  log: logForClient(),
  recordsUrl: href('/training-programs'),
  collabUrl: href('/collaborate'),
  ring: ring.map((r) => ({ ...r, image: href(r.image) })),
  kits: kits.map((k) => ({
    short: k.short,
    duration: k.duration,
    image: href(k.image),
    id: k.id,
    headline: k.headline,
    audiences: k.audiences,
    goals: k.goals || [],
    times: k.times,
    points: k.axes.slice(0, 3).map((a) => a.split(':')[0].trim()),
    page: href('/collaborate') + '#' + k.id,
    contact: href('/contact') + '?kit=' + k.id,
  })),
  labels: { aud: AUDIENCES, goal: GOALS, time: TIMES },
  campaign: site.campaign || {},
  net: netAll,
  bubbles,
  logo: href('/brand/logo-full-black.svg'),
  portrait: href('/img/brand/portrait-composite-560.webp'),
  cities: [
    ['الأحساء', ['الأحساء', 'الاحساء', 'الهفوف'], 25.38, 49.59], ['الرياض', ['الرياض', 'الدرعية', 'اليمامة', 'بيبان', 'الإمام محمد بن سعود', 'الجامعة السعودية الإلكترونية'], 24.71, 46.68],
    ['الدمام والخبر', ['الدمام', 'الخبر', 'الظهران', 'المنطقة الشرقية', 'الشرقية', 'البترول'], 26.43, 50.10], ['العلا', ['العلا'], 26.61, 37.92],
    ['القصيم', ['القصيم', 'بريدة'], 26.33, 43.97], ['المدينة المنورة', ['المدينة'], 24.47, 39.61], ['تبوك', ['تبوك', 'نيوم'], 28.38, 36.57],
    ['أبها', ['أبها'], 18.22, 42.51], ['مكة', ['مكة'], 21.39, 39.86], ['جدة', ['جدة', 'عفت'], 21.49, 39.19], ['حائل', ['حائل'], 27.52, 41.69],
    ['نجران', ['نجران'], 17.49, 44.13], ['الجوف', ['الجوف'], 29.97, 40.21], ['الطائف', ['الطائف'], 21.27, 40.42], ['ينبع', ['ينبع'], 24.09, 38.06],
    ['جازان', ['جازان'], 16.89, 42.55], ['حفر الباطن', ['حفر الباطن'], 28.43, 45.97], ['عُمان', ['عمان', 'بدية', 'بديّة'], 22.45, 58.80],
    ['الإمارات', ['الإمارات', 'أبوظبي', 'أبو ظبي', 'دبي', 'رأس الخيمة'], 24.80, 55.0], ['قطر', ['قطر'], 25.29, 51.53],
    ['البحرين', ['البحرين'], 26.23, 50.59], ['الكويت', ['الكويت'], 29.37, 47.98],
  ],
};
const wheel = wheelItems();

// شريط «ظهرتُ في»: جهة واحدة لكل عنصر معلَّم في قسم الإعلام
const seenOut = new Set();
const appeared = media.filter((m) => m.strip).map((m) => ({ name: (m.short || m.outlet.split('،')[0]).trim(), logo: m.logo }))
  .filter((o) => (seenOut.has(o.name) ? false : seenOut.add(o.name)));
const STATE = { past: 'منجز', now: 'جارٍ الآن', next: 'قادم' };
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: href('/'), inLanguage: 'ar' },
  ...eventSchemas(site, abs),
];
---
<Base
  description={site.description}
  active="home"
  local={[{ label: 'نظرة عامة', href: '#top' }, { label: 'مجالات التعاون', href: '#kits' }]}
  jsonld={jsonld}
>
<div id="splash" aria-hidden="true">
  <div class="sp-stage">
    <span class="sp-fig">
      <img class="sp-sketch" src={href('/img/brand/portrait-sketch-560.webp')} srcset={`${href('/img/brand/portrait-sketch-560.webp')} 560w, ${href('/img/brand/portrait-sketch-840.webp')} 840w`} sizes="(max-width: 820px) 70vw, 340px" width="560" height="694" alt="" fetchpriority="high">
      <img src={href('/img/brand/portrait-sash-560.webp')} srcset={`${href('/img/brand/portrait-sash-560.webp')} 560w, ${href('/img/brand/portrait-sash-840.webp')} 840w`} sizes="(max-width: 820px) 70vw, 340px" width="560" height="694" alt="">
    </span>
    <span class="sp-name"><img src={href('/brand/logo-full-black.svg')} width="2600" height="961" alt=""></span>
  </div>
</div>
<header class="hero" id="top">
  <div class="ringstage" id="ringStage">
    <div class="ring" id="ring" aria-label="صور من البرامج"></div>
    <div class="core"><div class="center">
      <div class="pfig" id="pfig" data-in>
        <img class="portrait" src={href('/img/brand/portrait-sketch-560.webp')} srcset={`${href('/img/brand/portrait-sketch-560.webp')} 560w, ${href('/img/brand/portrait-sketch-840.webp')} 840w`} sizes="(max-width: 820px) 40vw, 240px" width="560" height="694" alt="رسم بالرصاص لي وأنا أحمل درع رواد الشباب العربي" fetchpriority="high">
        <span class="pfig-sash" aria-hidden="true"><img src={href('/img/brand/portrait-sash-560.webp')} srcset={`${href('/img/brand/portrait-sash-560.webp')} 560w, ${href('/img/brand/portrait-sash-840.webp')} 840w`} sizes="(max-width: 820px) 50vw, 300px" width="560" height="694" alt="" decoding="async"></span>
        <span class="pfig-photo" aria-hidden="true"><img src={href('/img/brand/portrait-photo-560.webp')} srcset={`${href('/img/brand/portrait-photo-560.webp')} 560w, ${href('/img/brand/portrait-photo-840.webp')} 840w`} sizes="(max-width: 820px) 40vw, 240px" width="560" height="694" alt="" loading="lazy" decoding="async"></span>
      </div>
      <h1 class="hero-name" data-in><span class="inkgold" data-ink style={`--logo:url(${href('/brand/logo-full-black.svg')})`}><img src={href('/brand/logo-full-black.svg')} alt={site.hero.headline + '، ' + site.tagline} width="2600" height="961"><i class="gold" aria-hidden="true"></i></span></h1>
      <p class="sub" id="sub" aria-live="polite" data-in style="--d:2">{site.hero.sub}</p>
      <p class="for-line" id="forLine" hidden></p>
      <div class="ctas hero-cta" data-in style="--d:3"><a class="more" href={href('/featured')}>مشاريع مميزة</a></div>
    </div></div>
  </div>
  <figure id="heroFig"><div class="win"><img src={href('/img/photos/p29.webp')} alt="أنا في استوديو التسجيل" width="1536" height="1024" fetchpriority="high"></div></figure>
</header>

{appeared.length > 2 && (
<section class="sec appear" aria-label="ظهرتُ في">
  <div class="wide">
    <p class="appear-h">ظهرتُ في</p>
    <div class="mq mq-names">
      <ul class="mq-track">
        {[0, 1].map((rep) => appeared.map((o) => (
          <li aria-hidden={rep ? 'true' : undefined}>{o.logo ? <img src={href(o.logo)} alt={rep ? '' : o.name} loading="lazy"> : <span dir="auto">{o.name}</span>}</li>
        )))}
      </ul>
    </div>
    <a class="more appear-more" href={href('/media')}>كل الظهور الإعلامي</a>
  </div>
</section>
)}

<section class="sec xp" aria-labelledby="xp-h">
  <div class="wide">
    <h2 id="xp-h" data-in>{site.experience.title}</h2>
    <div class="xp-cols" id="xpTrack" tabindex="0" aria-label="نبذات عن الخبرة">
      {[xpA, xpB].map((col) => (
        <ul>
          {col.map((it) => (
            <li data-in>
              <span class="xp-ico" set:html={ICONS[it.icon] || ICONS.spark}></span>
              <p>{it.text}</p>
            </li>
          ))}
        </ul>
      ))}
    </div>
    <div class="xp-nav" aria-hidden="false">
      <button type="button" id="xpPrev" aria-label="السابق">›</button>
      <button type="button" id="xpNext" aria-label="التالي">‹</button>
    </div>
    <ul class="xp-tags">{site.experience.tags.map((t) => <li>{t}</li>)}</ul>
  </div>
</section>

<section class="sec" aria-labelledby="hl">
  <div class="wide sec-head"><h2 id="hl" data-in>الأبرز.</h2><a class="more" href={href('/featured')}>مشاريع ومشاركات مميزة</a></div>
  <div class="gallery" id="gal">
    {highlights.map((h) => (
      <a class="slide" href={href(h.link)}>
        <img src={href(h.image)} alt="" loading="lazy" style={`object-position:${h.position}`}>
        <p>{h.title}.<span>{h.caption}</span></p>
      </a>
    ))}
  </div>
  <div class="paddles"><button type="button" id="prev" aria-label="السابق">›</button><button type="button" id="next" aria-label="التالي">‹</button></div>
</section>

{wheel.length > 0 && (
<section class="sec alt cal" id="calendar" aria-labelledby="cal-h">
  <div class="wide sec-head"><h2 id="cal-h" data-in>روزنامة المدرب.</h2><a class="more" href={href('/training-programs')}>سجل الأثر</a></div>
  <div class="wide">
    <p class="lede cal-lede" data-in>برامجي وفعالياتي بتتابعها الزمني. اسحب لأعلى أو لأسفل لتتنقل بينها.</p>
    <div class="wheel" id="wheel">
      <div class="wh-band" aria-hidden="true"></div>
      <div class="wh-view" id="whView" tabindex="0" role="list" aria-label="روزنامة المدرب">
        <ol class="wh-list">
          {wheel.map((x) => {
            const r = rangeAr(x.from, x.to);
            const sub = [x.org && 'بالتعاون مع ' + x.org, x.duration, x.location].filter(Boolean).join(' · ');
            return (
              <li class="wh-row" role="listitem" data-from={x.from} data-to={x.to} data-state={stateOf(x)}>
                <div class="wh-date"><b>{r.line}</b><span>{r.year}</span><i class="wh-state">{STATE[stateOf(x)]}</i></div>
                <div class="wh-main">
                  <h3>{x.title}</h3>
                  {sub && <p class="wh-sub">{sub}</p>}
                  {x.details && <p class="wh-det">{x.details}</p>}
                  <a class="more wh-like" href={href('/contact') + '?like=' + encodeURIComponent(x.title)} tabindex="-1">اطلب برنامجاً مشابهاً</a>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
      <button class="wh-btn up" type="button" id="whUp" aria-label="الأسبق"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg></button>
      <button class="wh-btn down" type="button" id="whDown" aria-label="الأحدث"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
    </div>
    <p class="wh-count" id="whCount" aria-live="polite"></p>
  </div>
</section>
)}

<section class="sec dark nums" aria-labelledby="nm">
  <div class="measure">
    <h2 id="nm" data-in>سنوات من العمل.<br>بالأرقام.</h2>
    <div class="grid4">
      <div class="stat" data-in style="--d:1"><span class="n"><span data-count={site.stats.programs}>{site.stats.programs}</span>+</span><span>مشاركة موثّقة في التدريب والإرشاد والتحكيم.</span></div>
      <div class="stat" data-in style="--d:2"><span class="n"><span data-count={site.stats.partners}>{site.stats.partners}</span>+</span><span>جهة حكومية وخاصة وغير ربحية.</span></div>
      <div class="stat" data-in style="--d:3"><span class="n"><span data-count={site.stats.beneficiaries}>{site.stats.beneficiaries.toLocaleString('en-US')}</span>+</span><span>شاب وشابة استفادوا من البرامج.</span></div>
    </div>
  </div>
</section>

<section class="sec dark const" id="constellation" aria-labelledby="cs-h">
  <div class="const-pin">
    <div class="wide const-head">
      <h2 id="cs-h" data-in>كوكبة<br>الأثر.</h2>
      <p class="const-cap" id="csCap" aria-live="polite"></p>
    </div>
    <div class="const-stage">
      <canvas id="csCanvas" role="img" aria-label="كل برنامج في سجل الأثر نقطة ضوء تتشكل مرة اسماً، ومرة خريطة، ومرة أعمدة سنوات" data-logo={href('/brand/logo-full-white.svg')}></canvas>
      <div class="cs-hand" id="csHand" aria-hidden="true">
        <i></i><i></i><i></i>
        <svg viewBox="0 0 48 62" width="44" height="57"><path d="M17 8.5a5 5 0 0 1 10 0V30l2.2-.5a4.2 4.2 0 0 1 5 2.8 4.3 4.3 0 0 1 5.4 2.2 4.3 4.3 0 0 1 4.6 3.8l.6 6.2c.5 4.9-1.1 9.4-4.4 12.8L38 61H22.5c-2.7 0-4.8-1.4-6.2-3.6L7.5 43.2a4.2 4.2 0 0 1 6.9-4.8L17 41.8V8.5z" fill="#fff" stroke="#1b1b1a" stroke-width="2.4" stroke-linejoin="round"/><path d="M27 30v8M33.4 33v6.5M39.6 36.5v5" fill="none" stroke="#1b1b1a" stroke-width="2" stroke-linecap="round" opacity=".55"/></svg>
      </div>
      <div class="tip" id="csTip" hidden></div>
    </div>
    <div class="const-ctl">
      <label class="const-scrub" dir="rtl">
        <input type="range" id="csScrub" min="0" max="1000" step="1" value="0" aria-label="تشكيل النقاط: من التبعثر إلى الاسم ثم الخريطة ثم السنوات">
      </label>
      <div class="const-steps" role="group" aria-label="عرض الكوكبة">
        <button type="button" data-cs="0" aria-pressed="true">الاسم</button>
        <button type="button" data-cs="1" aria-pressed="false">الخريطة</button>
        <button type="button" data-cs="2" aria-pressed="false">السنوات</button>
      </div>
    </div>
  </div>
</section>

<section class="sec dark" style="padding-top:40px" aria-labelledby="mp">
  <div class="wide">
    <div class="wall-head">
      <h2 id="mp" data-in>خريطة<br>الأثر.</h2>
      <p class="count"><span id="mCount">0</span><small id="mLabel"></small></p>
    </div>
    <div class="map-wrap">
      <svg class="map" id="map" viewBox="0 0 1000 600" role="img" aria-label="خريطة المدن التي قُدّمت فيها البرامج"><g class="geo" aria-hidden="true" set:html={geo}></g></svg>
      <div class="tip" id="mCard" hidden></div>
    </div>
    <p class="map-note">اضغط على المدينة لترى التفاصيل</p>
    {netAll.length <= 3 && (
      <div class="mq" aria-label="شعارات جهات تعاونتُ معها">
      <ul class="mq-track">
        {[0, 1].map((rep) => marquee.map((p) => (
          <li aria-hidden={rep ? 'true' : undefined}><img src={href(p.logo)} alt={rep ? '' : p.name} loading="lazy"></li>
        )))}
      </ul>
    </div>
    )}
  </div>
</section>

{netAll.length > 3 && (
<section class="sec dark net" id="network" aria-labelledby="net-h" style="padding-top:8px">
  <div class="wide">
    <div class="sec-head"><h2 id="net-h" data-in>شبكة<br>الشراكات.</h2><a class="more" href={href('/partnerships')}>كل الشركاء</a></div>
    <p class="net-note">مرّر المؤشر أو اضغط على جهة لترى برامجي معها.</p>
    <div class="netv" id="netv" aria-label="شبكة الجهات الأكثر تعاوناً وبرامجي معها"></div>
    <div class="net-card" id="netCard" aria-live="polite"></div>
    <div class="mq" aria-label="شعارات جهات تعاونتُ معها">
      <ul class="mq-track">
        {[0, 1].map((rep) => marquee.map((p) => (
          <li aria-hidden={rep ? 'true' : undefined}><img src={href(p.logo)} alt={rep ? '' : p.name} loading="lazy"></li>
        )))}
      </ul>
    </div>
  </div>
</section>
)}

<section class="sec alt" aria-labelledby="dd">
  <div class="wide">
    <div class="sec-head"><h2 id="dd" data-in>ما أقدّمه<br>لجهتك.</h2><a class="more" href={href('/collaborate')}>الحقائب التدريبية</a></div>
    <div class="bento">
      {site.services.map((s, i) => (
        <article class={`tile${s.image ? ' photo' : ''}${s.big ? ' big' : ''}${s.dark ? ' ink' : ''}`} data-in style={i % 3 ? `--d:${i % 3}` : undefined}>
          {s.image && <img src={href(s.image)} alt="" loading="lazy">}
          <h3>{s.title}.</h3>
          <p>{s.text}</p>
          {s.figure && <span class="huge">{s.figure}</span>}
        </article>
      ))}
    </div>
  </div>
</section>

{pillars.length > 0 && (
<section class="sec board" id="board" aria-labelledby="bd-h">
  <div class="wide">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="chalk" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="4" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="2.2"/></filter></svg>
    <div class="bd-frame">
      <h2 id="bd-h" class="chalk"><span>منهجي في التدريب</span></h2>
      <svg class="chalk-line" viewBox="0 0 300 18" aria-hidden="true"><path d="M3 10C40 3 70 15 110 8S190 4 230 10S280 11 297 6" pathLength="1"/></svg>
      <ol class="bd-steps">
        {pillars.map((pl, i) => (
          <li class="bd-step">
            <span class="bd-n"><svg viewBox="0 0 80 80" aria-hidden="true"><path d="M40 6C60 4 76 20 74 42S58 76 36 74S4 58 7 36S22 8 44 7" pathLength="1"/></svg><b>{i + 1}</b></span>
            <h3 class="chalk">{pl.title}</h3>
            <p>{pl.text}</p>
            {i < pillars.length - 1 && <svg class="bd-arrow" viewBox="0 0 120 40" aria-hidden="true"><path d="M112 22C84 8 52 32 14 18" pathLength="1"/><path d="M26 6L12 18L28 30" pathLength="1"/></svg>}
          </li>
        ))}
      </ol>
      <a class="chalk-link" href={href('/methodology')}>اقرأ منهجي كاملاً</a>
    </div>
  </div>
</section>
)}

{bubbles.length > 3 && (
<section class="sec bubsec" id="skills" aria-labelledby="bb-h">
  <div class="wide">
    <div class="sec-head"><h2 id="bb-h" data-in>مجالات<br>خبرتي.</h2></div>
    <p class="net-note">اسحب الكرات وارمِها، واضغط على أي مجال لترى الحقائب المرتبطة به.</p>
    <div class="bub-field" id="bubField"></div>
    <div class="bub-panel" id="bubPanel" aria-live="polite"></div>
  </div>
</section>
)}

<section class="sec dark feature" aria-labelledby="aw">
  <div class="wide">
    <div class="copy">
      <p class="kicker" data-in>{award.title}</p>
      <h2 id="aw" data-in style="--d:1">اعترافٌ عربي.<br>بأثرٍ سعودي.</h2>
      <p class="ink-fill" id="inkFill" style="font-size:var(--t-h2);font-weight:600;line-height:1.4;max-width:30ch">في النسخة الرابعة، اختارني مركز الشباب العربي ضمن أربعين رائداً من ثلاث عشرة دولة، في مسار ريادة الأعمال، تقديراً لسنوات من تمكين الشباب.</p>
      <a class="more" data-in style="--d:3" href={href('/arab-youth-pioneers')}>القصة الكاملة</a>
    </div>
    <div class="pair">
      <img data-in src={href(award.gallery[0]?.image || '/img/photos/p20.webp')} alt="لحظة تسلّم الدرع على المسرح في أبوظبي" loading="lazy" style="aspect-ratio:auto;max-height:720px">
      <div class="tilt" id="tilt" data-in style="--d:1"><img src={href(award.hero)} alt="أنا أحمل الدرع" loading="lazy" style="aspect-ratio:auto;max-height:720px;border-radius:0"></div>
    </div>
    <div class="facts">
      {awardFacts.map((f, i) => <div data-in style={i ? `--d:${i}` : undefined}><b>{f.value}</b><span>{f.label}</span></div>)}
    </div>
  </div>
</section>

{news.length > 0 && (
  <section class="sec" aria-labelledby="nw">
    <div class="wide">
      <div class="sec-head"><h2 id="nw" data-in>جديد.</h2><a class="more" href={href('/news')}>كل الأخبار</a></div>
      <div class="cards">
        {news.map((n) => (
          <a class="ccard line" href={href('/news/' + n.id)} data-in>
            {n.image && <div class="ph"><img src={href(n.image)} alt="" loading="lazy"></div>}
            <div class="body">
              <span class="meta"><span class="tag">{n.type}</span> {dateAr(n.date)}</span>
              <h3>{n.title}</h3>
              <p>{n.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section class="sec alt" id="kits" aria-labelledby="kt" style="padding-bottom:48px">
  <div class="wide">
    <div class="sec-head"><h2 id="kt" data-in>مجالات التعاون.</h2><a class="more" href={href('/collaborate')}>قارن الحقائب</a></div>
    <div class="finder">
      <div class="qs">
        <div class="q" data-in><h3>من جمهورك؟</h3><div class="seg" data-loop data-q="a">
          {Object.entries(AUDIENCES).map(([v, l], i) => <button type="button" aria-pressed={String(i === 0)} data-v={v}>{l}</button>)}
        </div></div>
        <div class="q" data-in style="--d:1"><h3>ما المخرج الذي تريده؟</h3><div class="seg" data-loop data-q="g">
          <button type="button" aria-pressed="true" data-v="">أي مخرج</button>
          {Object.entries(GOALS).map(([v, l]) => <button type="button" aria-pressed="false" data-v={v}>{l}</button>)}
        </div></div>
        <div class="q" data-in style="--d:2"><h3>كم لديكم من الوقت؟ <small>اختياري</small></h3><div class="seg" data-loop data-q="t">
          <button type="button" aria-pressed="true" data-v="">أي مدة</button>
          {Object.entries(TIMES).map(([v, l]) => <button type="button" aria-pressed="false" data-v={v}>{l}</button>)}
        </div></div>
      </div>
      <div class="result" id="result" aria-live="polite">
        <div class="r-main" id="rMain"></div>
        <div class="r-more" id="rMore"></div>
      </div>
    </div>
  </div>
</section>

{voices.length > 0 && (
  <section class="sec alt" aria-labelledby="vc">
    <div class="wide">
      <div class="sec-head"><h2 id="vc" data-in>ماذا يقولون.</h2><a class="more" href={href('/feedback')}>كل التوصيات</a></div>
      <div class="deck" id="deck">
        {voices.map((v, i) => (
          <figure class="voice" data-pos={i}><p>“{(v.quote || v.full).replace(/^[“"]|[”"]$/g, '')}”</p>{(v.name || v.role) && <footer>{v.name && <b>{v.name}</b>}{v.role && <span>{v.role}</span>}</footer>}</figure>
        ))}
      </div>
      <div class="deck-ctl"><button class="pill" type="button" id="deckNext">التوصية التالية</button><span id="deckPos">1 من {voices.length}</span></div>
    </div>
  </section>
)}

<section class="sec close center" id="contact" aria-labelledby="cl">
  <div class="measure">
    <h2 id="cl" data-in>{site.closing.title}</h2>
    <p data-in style="--d:1">{site.closing.text}</p>
    <div class="ctas" data-in style="--d:2"><a class="pill" href={href('/contact')}>اطلب برنامجاً</a><a class="more" href={links.wa} rel="noopener">تحدّث عبر واتساب</a></div>
  </div>
</section>

<script type="application/json" id="homeData" set:html={JSON.stringify(homeData)}></script>
<script>import '../scripts/home.js';</script>
<script>import '../scripts/wow.js';</script>
</Base>
