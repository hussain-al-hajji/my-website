---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getKits, href, AUDIENCES, GOALS, site } from '../lib/site.js';
import { coursesSchema } from '../lib/seo.js';

const kits = getKits();
---
<Base jsonld={coursesSchema(kits)} title="الحقائب التدريبية" description="حقائب تدريبية جاهزة للتخصيص حسب جهتكم وجمهوركم: التجارة الإلكترونية، العمل الحر، إدارة المشاريع، الإرشاد المهني، القيادة وغيرها."
  active="collaborate" local={[{ label: 'الحقائب', href: '#top' }, { label: 'منهجي', href: '/methodology' }]}>
  <PageHead title="الحقائب التدريبية." lead="كل حقيبة قابلة للتعديل في المدة والمحاور والتمارين لتناسب جهتكم وجمهوركم.">
    <div class="ctas" style="margin-top:28px"><a class="pill" href={href('/contact')}>اطلب برنامجاً</a><a class="more" href={href('/proposal')}>ابنِ عرضك</a><a class="more" href={href('/methodology')}>منهجي في التدريب</a><a class="more" href="https://academy.hussain-al-hajji.com/" rel="noopener">المنصة التفاعلية للبرامج</a></div>
  </PageHead>

  <section class="sec tight kitdeck-sec" aria-labelledby="kd-h">
    <div class="wide">
      <h2 class="h2" id="kd-h" data-in>نظرة سريعة على الحقائب.</h2>
      <p class="lede" style="margin-bottom:28px" data-in>اضغط على البطاقة لتقلبها وترى أهم محاورها، ثم انتقل إلى تفاصيلها أو اطلبها مباشرة.</p>
      <ul class="kd" data-kd>
        {kits.map((k) => (
          <li class="kd-i">
            <div class="kd-c">
              <button class="kd-f" type="button" aria-expanded="false" aria-label={`اقلب بطاقة ${k.short || k.title}`}>
                <img src={href(k.image)} alt="" loading="lazy" width="400" height="300">
                <span class="kd-t">{k.short || k.title}</span>
                <span class="kd-d">{k.duration}</span>
              </button>
              <div class="kd-b" aria-hidden="true">
                <p class="kd-h">{k.headline || k.short || k.title}</p>
                <ul>{k.axes.slice(0, 3).map((a) => <li>{a}</li>)}</ul>
                <div class="kd-a">
                  <a class="pill" href={`#${k.id}`} tabindex="-1">التفاصيل</a>
                  <a class="more" href={href('/contact') + '?kit=' + k.id} tabindex="-1">اطلبها</a>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div id="top" data-filter-root>
    <section class="sec alt tight">
      <div class="wide">
        <h2 class="h2" style="margin-bottom:20px" data-in>اختر جمهورك وما تريده.</h2>
        <p class="filter-label">الفئة</p>
        <div class="chips-l" data-loop role="group" aria-label="الفئة">
          <button class="fchip" type="button" aria-pressed="true" data-f="aud:">كل الفئات</button>
          {Object.entries(AUDIENCES).map(([v, l]) => <button class="fchip" type="button" aria-pressed="false" data-f={`aud:${v}`}>{l}</button>)}
        </div>
        <p class="filter-label">المخرج المتوقع</p>
        <div class="chips-l" data-loop role="group" aria-label="المخرج المتوقع">
          <button class="fchip" type="button" aria-pressed="true" data-f="goal:">كل المخرجات</button>
          {Object.entries(GOALS).map(([v, l]) => <button class="fchip" type="button" aria-pressed="false" data-f={`goal:${v}`}>{l}</button>)}
        </div>
        <p class="result-count" style="margin-top:16px" data-count-out aria-live="polite"></p>
      </div>
    </section>

    {kits.map((k) => (
      <article class="kit wide" id={k.id} data-item data-aud={k.audiences.join('|')} data-goal={(k.goals || []).join('|')}>
        <div class="side">
          <img src={href(k.image)} alt="" loading="lazy" width="800" height="600">
          <a class="pill" href={href('/contact') + '?kit=' + k.id}>اطلب هذه الحقيبة</a>
          <a class="more" href={href('/proposal') + '?kit=' + k.id}>أضفها إلى عرضك</a>
        </div>
        <div>
          <h2>{k.title}</h2>
          <p class="dur">{k.duration}</p>
          <p class="lede" style="margin-top:14px">{k.summary}</p>
          {k.headline && <p style="margin-top:14px;font-weight:600">{k.headline}</p>}
          <h3>الفئة المستهدفة</h3>
          <ul class="bul">{k.audience.map((a) => <li>{a}</li>)}</ul>
          <h3>المحاور</h3>
          <ul class="bul">{k.axes.map((a) => <li>{a}</li>)}</ul>
          {k.exercises?.length > 0 && (<>
            <h3>التمارين والأنشطة</h3>
            <ul class="bul">{k.exercises.map((a) => <li>{a}</li>)}</ul>
          </>)}
          {k.outcomes?.length > 0 && (<>
            <h3>المخرجات</h3>
            <ul class="bul">{k.outcomes.map((a) => <li>{a}</li>)}</ul>
          </>)}
        </div>
      </article>
    ))}
  </div>

  <section class="sec close center dark">
    <div class="measure">
      <h2>لديكم احتياج آخر؟</h2>
      <p>تُصمَّم البرامج أيضاً حسب الطلب. أخبرني عن هدفكم وجمهوركم.</p>
      <div class="ctas"><a class="pill" href={href('/contact')}>اطلب برنامجاً</a><a class="more" href={'https://wa.me/' + site.contact.whatsapp} rel="noopener">واتساب</a></div>
    </div>
  </section>
  <script>import '../scripts/cards.js';</script>
  <script>
    // يمرّر باحث الرئيسية اختياره عبر ?aud=...&goal=...
    addEventListener('load', () => {
      const q = new URLSearchParams(location.search);
      for (const k of ['aud', 'goal']) {
        const v = q.get(k);
        if (v) document.querySelector(`[data-f="${k}:${CSS.escape(v)}"]`)?.click();
      }
    });
  </script>
</Base>
