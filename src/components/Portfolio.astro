---
// ملف الأعمال (Portfolio): صفحات A4 أفقية تُحوَّل إلى PDF عند البناء (scripts/make-pdf.mjs)، وكل رقم فيها محسوب من src/data.
import Base from '../layouts/Base.astro';
import QRCode from 'qrcode';
import '../styles/portfolio.css';
import { site, href, abs } from '../lib/site.js';
import { portfolioData, roleIcon } from '../lib/portfolio-data.js';
import geo from '../assets/gulf-geo.html?raw';

const { lang = 'ar' } = Astro.props;
const en = lang === 'en';
// نصوص الواجهة بالعربية والإنجليزية؛ بيانات المحتوى تُقرأ بالإنجليزية من حقول en إن وُجدت وإلا العربية
const T = en ? {
  title: 'Portfolio', file: '/hussain-al-hajji-portfolio-en.pdf', dl: 'Download portfolio (PDF)', back: 'Back to the website', kicker: 'Portfolio',
  me: 'About me', rolesH: 'Roles we can collaborate on', stats: ['programs & events', 'partner organizations', 'beneficiaries', 'training kits'],
  map: 'Impact Map', mapAria: 'Map of the cities where the programs were delivered', part: 'participations', topLoc: 'Top locations', home: 'Al-Ahsa, where the journey began; arcs extend from it to every location.',
  impact: 'Impact in Numbers', topics: 'Top topics', samples: 'Examples of other topics', inPerson: 'in person', remote: 'remote', programs: 'programs',
  method: 'My Training Methodology', proj: 'Projects I Founded', feat: 'Featured Projects & Engagements', kits: 'Ready-to-Customize Training Kits',
  partners: 'Organizations I Have Made an Impact With', media: 'Press & Media Appearances', voices: 'What They Say About Working With Me',
  back1: "Let's make an impact together.", back2: 'I design and deliver programs in person and remotely, and I tailor every kit to your organization and audience.',
  contact: ['Email', 'Mobile & WhatsApp', 'LinkedIn', 'Website'], qr: 'Scan to visit the website', other: 'Other topics', groupCap: 'Group photo of the Arab Youth Pioneers, fourth edition, at the end of the ceremony',
} : {
  title: 'ملف الأعمال', file: '/hussain-al-hajji-portfolio.pdf', dl: 'حمّل البورتفليو (PDF)', back: 'العودة إلى الموقع', kicker: 'ملف الأعمال · Portfolio',
  me: 'من أنا', rolesH: 'أدوار يمكننا التعاون فيها', stats: ['برنامج وفعالية', 'جهة شريكة', 'مستفيد', 'حقيبة تدريبية'],
  map: 'خريطة الأثر', mapAria: 'خريطة المدن التي قُدّمت فيها البرامج', part: 'مشاركة', topLoc: 'أكثر المواقع مشاركة', home: 'الأحساء، منطلق الرحلة، ومنها تمتد الأقواس إلى كل موقع.',
  impact: 'الأثر في أرقام', topics: 'أكثر المواضيع', samples: 'نماذج من مواضيع أخرى', inPerson: 'حضورياً', remote: 'عن بُعد', programs: 'برنامجاً',
  method: 'منهجي في التدريب', proj: 'مشاريع أسستها', feat: 'مشاريع ومشاركات مميزة', kits: 'حقائب تدريبية جاهزة للتخصيص',
  partners: 'جهات صنعتُ معها الأثر', media: 'استضافات في الصحافة والإعلام', voices: 'قالوا عن العمل معي',
  back1: 'لنصنع الأثر معاً.', back2: 'أصمّم البرامج وأقدّمها حضورياً وعن بُعد، وأخصّص كل حقيبة لجهتكم وجمهوركم.',
  contact: ['البريد', 'الجوال وواتساب', 'لينكدإن', 'الموقع'], qr: 'امسح لزيارة الموقع', other: 'مواضيع أخرى', groupCap: null,
};
const { tx, S, sName, sTag, sRole, sFocus, aw, cityName, featTitle, y0, y1, kits, n, bioP, intro, remoteN, inN, logos, voices, outlets, galaxy, perYear, COLS, DOT, colW, yearsSvgW, yearsSvgH, topics, topicName, otherSamples, remoteDeg, pillars, impactMap, topCities, awardImg, awardGroup, roles, rolesShown, projects, featured, records, honors, award, pages } = portfolioData(lang, T.other);
const qr = await QRCode.toString(abs('/'), { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#f5f5f2', light: '#0b0b0a' } });

const chunk = (arr, k) => arr.reduce((a, x, i) => (i % k ? a[a.length - 1].push(x) : a.push([x]), a), []);
const projPages = chunk(projects, 4);
const featPages = chunk(featured, 8);
const kitPages = chunk(kits, 6);

// ترقيم الصفحات
let pg = 1;
const P = () => String(++pg).padStart(2, '0');
const TOTAL = 1 + 1 + (impactMap.total ? 1 : 0) + 1 + (pillars.length ? 1 : 0) + projPages.length + 1 + featPages.length + kitPages.length + 1 + (voices.length ? 1 : 0) + 1;
const tot = String(TOTAL).padStart(2, '0');
const order = ['me', ...(impactMap.total ? ['map'] : []), 'impact', ...(pillars.length ? ['method'] : []), 'proj', 'award', 'feat', 'kits', 'partners', 'voices'];
const anc = (a) => (en ? (a === 'start' ? 'end' : a === 'end' ? 'start' : a) : a);
const awardGroupCap = en ? T.groupCap : awardGroup?.caption;
const sec = Object.fromEntries(order.map((k, i) => [k, String(i + 1).padStart(2, '0')]));
---
<Base title={T.title} description={en ? `My portfolio and projects since ${y0}.` : `ملف أعمالي ومشاريعي منذ ${y0}.`} noindex cta={null} bare>
  <main class="pp-doc" id="main" dir={en ? 'ltr' : undefined} lang={en ? 'en' : undefined}>
    <p class="no-print pp-bar"><a class="pill" href={href(T.file)} download>{T.dl}</a><a class="more" href={href('/')}>{T.back}</a></p>

    <!-- الغلاف -->
    <section class="pp pp-dark pp-cover">
      <svg class="pp-galaxy" viewBox="0 0 400 400" aria-hidden="true">
        {galaxy.map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r={d.s} fill="#e2b257" opacity={d.o.toFixed(2)} />)}
      </svg>
      <img class="pp-cover-photo" src={href('/img/brand/portrait-photo-840.webp')} alt="" width="560" height="694">
      <div class="pp-cover-txt">
        <p class="pp-kicker">{T.kicker}</p>
        {en
          ? <h1 class="pp-name"><span>{sName}</span><em>{sTag}</em></h1>
          : <h1><img src={href('/brand/logo-full-white.svg')} alt={site.name + '، ' + site.tagline} width="2600" height="961"></h1>}
        <p class="pp-cover-role">{sRole}</p>
        {sFocus && <p class="pp-cover-focus">{sFocus}</p>}
        <p class="pp-cover-years"><b>{y0}</b><i></i><b>{y1}</b></p>
      </div>
    </section>

    <!-- من أنا -->
    <section class="pp pp-paper">
      <header class="pp-head"><span class="pp-num">{sec.me}</span><h2>{T.me}</h2>{en ? <span class="pp-mark pp-mark-t">{sName}</span> : <img class="pp-mark" src={href('/brand/logo-full-black.svg')} alt="" width="2600" height="961">}</header>
      <div class="pp-me">
        <div class="pp-me-txt">
          <p class="pp-lead">{bioP.lead}</p>
          {intro.slice(0, 2).map((t) => <p class="pp-just">{t}</p>)}
          {roles.length > 0 && (
            <div class="pp-roles">
              <h3 class="pp-sub">{T.rolesH}</h3>
              <ul>{roles.map((r, i) => <li><span class="ic" set:html={roleIcon(r)}></span><b>{rolesShown[i] || r}</b><i>{String(i + 1).padStart(2, '0')}</i></li>)}</ul>
            </div>
          )}
        </div>
        <figure class="pp-me-fig"><img src={href('/img/brand/portrait-composite-840.webp')} alt="" width="560" height="694"></figure>
      </div>
      <ul class="pp-stats">
        <li><b>{n(site.stats.programs)}+</b><span>{T.stats[0]}</span></li>
        <li><b>{n(site.stats.partners)}+</b><span>{T.stats[1]}</span></li>
        <li><b>{n(site.stats.beneficiaries)}+</b><span>{T.stats[2]}</span></li>
        <li><b>{n(kits.length)}</b><span>{T.stats[3]}</span></li>
      </ul>
      <footer class="pp-foot"><span>hussain-al-hajji.com</span><span dir="ltr">{P()} / {tot}</span></footer>
    </section>

    <!-- خريطة الأثر: نفس خريطة الرئيسية مرسومة كاملة -->
    {impactMap.total > 0 && (
      <section class="pp pp-dark pp-map">
        <header class="pp-head"><span class="pp-num">{sec.map}</span><h2>{T.map}</h2>{en ? <span class="pp-mark pp-mark-t">{sName}</span> : <img class="pp-mark" src={href('/brand/logo-full-white.svg')} alt="" width="2600" height="961">}</header>
        <div class="pp-map-body">
          <svg class="map in" viewBox="0 0 1000 600" role="img" aria-label={T.mapAria}>
            <g class="geo" aria-hidden="true" set:html={geo}></g>
            <g>{impactMap.placed.filter((c) => c.arc).map((c) => <path class="arc" d={c.arc} />)}</g>
            <g>{impactMap.placed.map((c) => (
              <g class="c">
                <circle class="halo" cx={c.x} cy={c.y} r={c.rad * 2} />
                <circle class={'city' + (c.isHome ? ' home' : '')} cx={c.x} cy={c.y} r={c.rad} />
                {c.label && <text x={c.label.x} y={c.label.y} text-anchor={anc(c.label.anchor)} direction={en ? 'ltr' : 'rtl'}>{cityName(c.name)}</text>}
                {c.label && <text class="sm" x={c.label.x} y={c.label.y + 18} text-anchor={anc(c.label.anchor)} direction={en ? 'ltr' : 'rtl'}>{c.n} {T.part}</text>}
              </g>
            ))}</g>
          </svg>
          <aside class="pp-map-side">
            <p class="pp-map-count"><b>{impactMap.total}</b><span>{impactMap.label}</span></p>
            <p class="pp-cap">{T.topLoc}</p>
            <ol class="pp-map-top">{topCities.map((c) => <li><span>{cityName(c.name)}</span><b>{c.n}</b></li>)}</ol>
            <p class="pp-map-home"><i></i>{T.home}</p>
          </aside>
        </div>
        <footer class="pp-foot"><span>hussain-al-hajji.com</span><span dir="ltr">{P()} / {tot}</span></footer>
      </section>
    )}

    <!-- الأثر في أرقام -->
    <section class="pp pp-dark">
      <header class="pp-head"><span class="pp-num">{sec.impact}</span><h2>{T.impact}</h2>{en ? <span class="pp-mark pp-mark-t">{sName}</span> : <img class="pp-mark" src={href('/brand/logo-full-white.svg')} alt="" width="2600" height="961">}</header>
      <div class="pp-impact">
        <div class="pp-years">
          <p class="pp-cap">{en ? `${n(records.length)} documented programs, year by year (each dot is one program)` : `${n(records.length)} برنامجاً موثّقاً، سنة بعد سنة (كل نقطة برنامج)`}</p>
          <svg viewBox={`0 0 ${yearsSvgW} ${yearsSvgH}`} aria-hidden="true">
            {perYear.map((p, i) => {
              const cx = en ? colW * (i + 0.5) : yearsSvgW - colW * (i + 0.5);
              return (<g>
                {Array.from({ length: p.c }, (_, k) => <circle cx={cx + ((k % COLS) - (COLS - 1) / 2) * DOT} cy={yearsSvgH - 40 - Math.floor(k / COLS) * DOT} r="3.3" fill="#e2b257" />)}
                <text x={cx} y={yearsSvgH - 20} text-anchor="middle" class="yl">{p.y}</text>
                <text x={cx} y={yearsSvgH - 4} text-anchor="middle" class="yc">{p.c}</text>
              </g>);
            })}
          </svg>
        </div>
        <div class="pp-side">
          <div class="pp-split">
            <div class="pp-donut" style={`--d:${remoteDeg.toFixed(1)}deg`}><span><b>{n(records.length)}</b>{T.programs}</span></div>
            <ul>
              <li><i class="a"></i><b>{n(inN)}</b> {T.inPerson}</li>
              <li><i class="b"></i><b>{n(remoteN)}</b> {T.remote}</li>
            </ul>
          </div>
          <p class="pp-cap" style="margin-bottom:0">{T.topics}</p>
          <ul class="pp-topics">
            {topics.map(([t, c]) => <li><span>{t === T.other ? t : topicName(t)}</span><b>{c}</b><i style={`--w:${(c / topics[0][1] * 100).toFixed(1)}%`}></i></li>)}
          </ul>
          {otherSamples.length > 0 && (
            <ul class="pp-samples" aria-label={T.samples}>
              {otherSamples.map((s) => <li>{s}</li>)}
            </ul>
          )}
        </div>
      </div>
      <footer class="pp-foot"><span>hussain-al-hajji.com</span><span dir="ltr">{P()} / {tot}</span></footer>
    </section>

    <!-- منهجي في التدريب: سبورة الرئيسية نفسها مرسومة كاملة -->
    {pillars.length > 0 && (
      <section class="pp pp-paper pp-method">
        <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="chalk" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="4" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="2.2"/></filter></svg>
        <header class="pp-head"><span class="pp-num">{sec.method}</span>{en ? <span class="pp-mark pp-mark-t">{sName}</span> : <img class="pp-mark" src={href('/brand/logo-full-black.svg')} alt="" width="2600" height="961">}</header>
        <div class="bd-frame">
          <h2 id="bd-h" class="chalk drawn"><span class="hl">{en ? (pages.methodology.en?.title || T.method) : T.method}</span></h2>
          <svg class="chalk-line drawn" viewBox="0 0 300 18" aria-hidden="true"><path d="M3 10C40 3 70 15 110 8S190 4 230 10S280 11 297 6" pathLength="1"/></svg>
          <ol class="bd-steps">
            {pillars.map((pl, i) => (
              <li class="bd-step drawn">
                <span class="bd-n"><svg viewBox="0 0 80 80" aria-hidden="true"><path d="M40 6C60 4 76 20 74 42S58 76 36 74S4 58 7 36S22 8 44 7" pathLength="1"/></svg><b>{i + 1}</b></span>
                <h3 class="chalk"><span class="hl">{pl.title}</span></h3>
                <p>{pl.text}</p>
                {i < pillars.length - 1 && <svg class="bd-arrow" viewBox="0 0 120 40" aria-hidden="true"><path d="M112 22C84 8 52 32 14 18" pathLength="1"/><path d="M26 6L12 18L28 30" pathLength="1"/></svg>}
              </li>
            ))}
          </ol>
          <a class="chalk-link" href={abs('/methodology')}>{en ? 'Read my full methodology: ' : 'اقرأ منهجي كاملاً: '}hussain-al-hajji.com/methodology</a>
        </div>
        <footer class="pp-foot"><span>hussain-al-hajji.com/methodology</span><span dir="ltr">{P()} / {tot}</span></footer>
      </section>
    )}

    <!-- مشاريعي -->
    {projPages.map((list, pi) => (
      <section class="pp pp-paper">
        <header class="pp-head"><span class="pp-num">{sec.proj}</span><h2>{T.proj}{projPages.length > 1 && <small> {pi + 1}/{projPages.length}</small>}</h2>{en ? <span class="pp-mark pp-mark-t">{sName}</span> : <img class="pp-mark" src={href('/brand/logo-full-black.svg')} alt="" width="2600" height="961">}</header>
        <div class="pp-proj">
          {list.map((p) => (
            <article>
              {p.image ? <img src={href(p.image)} alt="" loading="eager"> : <span class="ph"></span>}
              <div>
                <h3>{en && p.nameEn ? p.nameEn : p.name}{!en && p.nameEn && <small dir="ltr">{p.nameEn}</small>}</h3>
                {tx(p, 'status') && <p class="tag">{tx(p, 'status')}</p>}
                <p class="pp-just clamp">{(en && p.en?.desc) || p.desc}</p>
              </div>
            </article>
          ))}
        </div>
        <footer class="pp-foot"><span>hussain-al-hajji.com/my-projects</span><span dir="ltr">{P()} / {tot}</span></footer>
      </section>
    ))}

    <!-- رواد الشباب العربي -->
    <section class="pp pp-dark pp-award">
      <img class="pp-award-img" src={href(awardImg)} alt="">
      <div class="pp-award-txt">
        <header class="pp-head"><span class="pp-num">{sec.award}</span><h2>{aw('title')}</h2></header>
        <p class="pp-kicker">{aw('edition')} · {aw('dates')}</p>
        <p class="pp-lead">{aw('lead')}</p>
        {aw('story')?.[0] && <p class="pp-just pp-story">{aw('story')[0]}</p>}
        <ul class="pp-facts">{(aw('facts') || []).slice(0, 4).map((f) => <li><b>{f.value}</b><span>{f.label}</span></li>)}</ul>
        <p class="pp-fine">{aw('sponsor')}</p>
      </div>
      {awardGroup && <figure class="pp-group"><img src={href(awardGroup.image)} alt=""><figcaption>{awardGroupCap}</figcaption></figure>}
      <footer class="pp-foot"><span>hussain-al-hajji.com/arab-youth-pioneers</span><span dir="ltr">{P()} / {tot}</span></footer>
    </section>

    <!-- مشاركات مميزة -->
    {featPages.map((list, pi) => (
      <section class="pp pp-paper">
        <header class="pp-head"><span class="pp-num">{sec.feat}</span><h2>{T.feat}{featPages.length > 1 && <small> {pi + 1}/{featPages.length}</small>}</h2>{en ? <span class="pp-mark pp-mark-t">{sName}</span> : <img class="pp-mark" src={href('/brand/logo-full-black.svg')} alt="" width="2600" height="961">}</header>
        <div class="pp-feat">
          {list.map((f) => (
            <article>
              <span class="lg">{f.logo && <img src={href(f.logo)} alt="" loading="eager">}</span>
              <div><p class="grp">{featTitle[f.group] || f.group}</p><h3 class="clamp3">{tx(f, 'title')}</h3>{tx(f, 'orgs') && <p class="org">{tx(f, 'orgs')}</p>}</div>
            </article>
          ))}
        </div>
        <footer class="pp-foot"><span>hussain-al-hajji.com/featured</span><span dir="ltr">{P()} / {tot}</span></footer>
      </section>
    ))}

    <!-- الحقائب -->
    {kitPages.map((list, pi) => (
      <section class="pp pp-paper pp-alt">
        <header class="pp-head"><span class="pp-num">{sec.kits}</span><h2>{T.kits}{kitPages.length > 1 && <small> {pi + 1}/{kitPages.length}</small>}</h2>{en ? <span class="pp-mark pp-mark-t">{sName}</span> : <img class="pp-mark" src={href('/brand/logo-full-black.svg')} alt="" width="2600" height="961">}</header>
        <div class="pp-kits">
          {list.map((k) => (
            <article>
              <img src={href(k.image)} alt="" loading="eager">
              <h3>{tx(k, 'short') || k.title}</h3>
              <p class="dur">{tx(k, 'duration')}</p>
              {tx(k, 'headline') && <p class="hl">{tx(k, 'headline')}</p>}
            </article>
          ))}
        </div>
        <footer class="pp-foot"><span>hussain-al-hajji.com/collaborate</span><span dir="ltr">{P()} / {tot}</span></footer>
      </section>
    ))}

    <!-- الشركاء والإعلام -->
    <section class="pp pp-paper">
      <header class="pp-head"><span class="pp-num">{sec.partners}</span><h2>{T.partners}</h2>{en ? <span class="pp-mark pp-mark-t">{sName}</span> : <img class="pp-mark" src={href('/brand/logo-full-black.svg')} alt="" width="2600" height="961">}</header>
      <ul class="pp-logos">{logos.slice(0, 60).map((p) => <li><img src={href(p.logo)} alt={(en && p.en?.name) || p.name} loading="eager"></li>)}</ul>
      {outlets.length > 0 && (
        <div class="pp-media"><h3 class="pp-sub">{T.media}</h3><ul class="pp-mlogos">{outlets.map((o) => <li><img src={href(o.logo)} alt={o.name} loading="eager"></li>)}</ul></div>
      )}
      <footer class="pp-foot"><span>hussain-al-hajji.com/partnerships</span><span dir="ltr">{P()} / {tot}</span></footer>
    </section>

    <!-- قالوا -->
    {voices.length > 0 && (
      <section class="pp pp-dark">
        <header class="pp-head"><span class="pp-num">{sec.voices}</span><h2>{T.voices}</h2>{en ? <span class="pp-mark pp-mark-t">{sName}</span> : <img class="pp-mark" src={href('/brand/logo-full-white.svg')} alt="" width="2600" height="961">}</header>
        <div class="pp-voices" style={`--n:${voices.length}`}>
          {voices.map((t) => (
            <blockquote><p class="pp-just">{t.text}</p>{(t.name || t.role) && <footer>{t.name && <b>{t.name}</b>}{t.role && <span>{t.role}</span>}</footer>}</blockquote>
          ))}
        </div>
        <p class="pp-honors">{en ? `And ${n(honors.length)} certificates of thanks and appreciation from the organizations I have worked with.` : `و${n(honors.length)} شهادة شكر وتقدير من الجهات التي عملتُ معها.`}</p>
        <footer class="pp-foot"><span>hussain-al-hajji.com/feedback</span><span dir="ltr">{P()} / {tot}</span></footer>
      </section>
    )}

    <!-- الغلاف الخلفي -->
    <section class="pp pp-dark pp-back">
      <svg class="pp-galaxy" viewBox="0 0 400 400" aria-hidden="true">
        {galaxy.map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r={d.s} fill="#e2b257" opacity={(d.o * 0.5).toFixed(2)} />)}
      </svg>
      <div class="pp-back-txt">
        <h2>{T.back1}</h2>
        <p class="pp-lead">{T.back2}</p>
        <ul class="pp-contact">
          <li><span>{T.contact[0]}</span><b dir="ltr">{site.contact.email}</b></li>
          <li><span>{T.contact[1]}</span><b dir="ltr">{site.contact.phone}</b></li>
          <li><span>{T.contact[2]}</span><b dir="ltr">linkedin.com/in/hussain-al-hajji</b></li>
          <li><span>{T.contact[3]}</span><b dir="ltr">hussain-al-hajji.com</b></li>
        </ul>
      </div>
      <div class="pp-qr"><div set:html={qr}></div><p>{T.qr}</p></div>
      {en ? <span class="pp-back-logo pp-mark-t">{sName}</span> : <img class="pp-back-logo" src={href('/brand/logo-full-white.svg')} alt="" width="2600" height="961">}
    </section>
  </main>
</Base>
