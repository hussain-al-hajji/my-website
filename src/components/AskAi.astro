---
// «اسأل الذكاء الاصطناعي عني»: عنوان وأيقونات المنصات فقط. كل أيقونة رابط إلى المنصة ومعه أول سؤال مفعَّل من لوحة التحكم (askAi.questions)
import { site } from '../lib/site.js';
const q = (site.askAi?.questions || []).find((x) => x.on !== false && x.prompt);
const TOOLS = [
  { n: 'ChatGPT', base: 'https://chatgpt.com/?hints=search&q=', svg: '<circle cx="16.6" cy="12" r="4.4"/><circle cx="14.3" cy="16" r="4.4"/><circle cx="9.7" cy="16" r="4.4"/><circle cx="7.4" cy="12" r="4.4"/><circle cx="9.7" cy="8" r="4.4"/><circle cx="14.3" cy="8" r="4.4"/>' },
  { n: 'Claude', base: 'https://claude.ai/new?q=', svg: '<path d="M12 2.8v18.4M3.6 7.4l16.8 9.2M3.6 16.6l16.8-9.2M2.8 12h18.4M6 4.5l12 15M18 4.5 6 19.5"/>' },
  { n: 'Perplexity', base: 'https://www.perplexity.ai/search?q=', svg: '<path d="M12 2.6v18.8M6 6.4l6 5.6 6-5.6M6 17.6l6-5.6 6 5.6M4.4 8.6v6.8M19.6 8.6v6.8"/>' },
  { n: 'Grok', base: 'https://grok.com/?q=', svg: '<circle cx="12" cy="12" r="8.4"/><path d="m6.2 18.4 11.6-12.8"/>' },
];
const { id = 'ask-h', tag = 'h2' } = Astro.props;
const Title = tag;
---
{q && (
  <>
    <Title id={id} data-in>{site.askAi.title || 'اسأل الذكاء الاصطناعي عني'}</Title>
    <ul class="ask-tools" data-in style="--d:1">
      {TOOLS.map((t) => (
        <li><a href={t.base + encodeURIComponent(q.prompt)} target="_blank" rel="noopener" aria-label={`اسأل ${t.n} عن حسين الحاجي`}>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.svg}></svg><span>{t.n}</span></a></li>
      ))}
    </ul>
  </>
)}
