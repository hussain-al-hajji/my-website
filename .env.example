# إعدادات عامة بطبيعتها (تظهر في كود المتصفح). تُضبط في GitHub: Settings > Secrets and variables > Actions > Variables.
# مفتاح Firebase للويب ليس سراً، لكن الحماية الفعلية في القائمة المسموحة داخل الـ Worker.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# عنوان الـ Worker بعد نشره، مثل https://hussain-site-admin.<account>.workers.dev
PUBLIC_API_URL=
